      "prose",
      "7:column:0",
      null,
      [
        "S001"
      ]
    ],
    [
      "P009",
      "4.3.1 PRODUCT LABEL",
      false,
      "heading",
      "7:column:0",
      null,
      [
        "S001"
      ]
    ],
    [
      "P010",
      "Icons, warnings and notes for products form a part of safety rules.",
      false,
      "prose",
      "7:column:0",
      null,
      [
        "S002"
      ]
    ],
    [
      "P011",
      "Labels shall not be\nremoved or covered, and shall be kept clear during the whole life cycle of the product.",
      false,
      "prose",
      "7:column:0",
      null,
      [
        "S002"
      ]
    ],
    [
      "P012",
      "Please replace any damaged label immediately.",
