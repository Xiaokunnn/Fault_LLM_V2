    [
      "P001",
      "service provider may entrust the manufacturer/supplier to organize relevant trainings.",
      false,
      "prose",
      "7:column:0",
      null,
      []
    ],
    [
      "P002",
      "Besides, operators shall ensure that the responsible persons have completely understood\nthe operating instructions.",
      false,
      "prose",
      "7:column:0",
      null,
      []
    ],
    [
      "P003",
      "4.3 SAFETY MEASURES",
      false,
      "heading",
      "7:column:0",
      null,
      []
    ],
    [
      "P004",
      "This product is well designed.",
      false,
      "prose",
      "7:column:0",
      null,
      [
        "S001"
      ]
    ],
    [
      "P005",
      "Original parts and fittings comply with safety rules.",
      false,
      "prose",
      "7:column:0",
      null,
      [
        "S001"
      ]
    ],
    [
      "P006",
      "Any\nstructural modification or utilization of non-original components may bring safety risks.",
      false,
      "prose",
      "7:column:0",
      null,
      [
        "S001"
      ]
    ],
    [
      "P007",
      "Caution\nMake sure that the product is running within its working scope.",
      false,
      "prose",
      "7:column:0",
      null,
      [
        "S001"
      ]
    ],
    [
