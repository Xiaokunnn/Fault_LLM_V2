    ],
    [
      "P013",
      "4.4 SAFETY PROTECTION MEASURES",
      false,
      "heading",
      "7:column:0",
      null,
      [
        "S002"
      ]
    ],
    [
      "P014",
      "4.4.1 DURING NORMAL OPERATION",
      false,
      "heading",
      "7:column:0",
      null,
      [
        "S003"
      ]
    ],
    [
      "P015",
      "• Please contact the local power supply company in case of any power supply problem.",
      false,
      "prose",
      "7:column:0",
      null,
      [
        "S004"
      ]
    ],
    [
      "P016",
      "• Please do not directly touch the covered part of the product since it will produce heat.",
      false,
      "prose",
      "7:column:0",
      null,
      [
        "S004"
      ]
    ],
    [
      "P017",
      "Before the pump is put into use, an undeformed coupling protection cover shall be\n•\nalways used to protect the coupling, so that the protective plate of coupling will not touch\nthe rotating coupling.",
      false,
      "prose",
      "7:column:0",
      null,
      [
        "S004"
      ]
    ],
    [
      "P018",
      "• The connection box of motor shall be always closed.",
      false,
      "prose",
      "7:column:0",
      null,
      [
        "S004"
      ]
    ],
    [
      "P019",
      "4.4.2 DURING INSTALLATION, OPERATION AND MAINTENANCE",
      false,
      "heading",
      "7:column:0",
      null,
      [
        "S004"
      ]
    ],
    [
      "P020",
      "Only the authorized personnel can install, maintain and check products, and repair electrical\ncomponents.",
      false,
      "prose",
      "7:column:0",
      null,
      [
        "S005"
      ]
    ],
    [
      "P021",
      "Abide by the local safety rules.",
      false,
      "prose",
      "7:column:0",
      null,
      [
        "S005"
      ]
    ],
    [
      "P022",
      "Warning\nBefore installation, maintenance and repair, be sure to shut off the product power\nsupply safely.",
      false,
      "prose",
      "7:column:0",
      null,
      [
        "S005"
      ]
    ],
    [
      "P023",
      "Warning\nThe pump surface may be hot after continuous running.",
      false,
      "prose",
      "7:column:0",
      null,
      [
        "S005"
      ]
    ],
    [
      "P024",
      "Warning\nWhen starting the pump, make sure that nobody can come close to the rotating\ncomponent.",
      false,
      "prose",
      "7:column:0",
      null,
      [
        "S005"
      ]
    ],
    [
      "P025",
      "Warning\nCarefully operate the pump filled with dangerous liquid.",
      false,
      "prose",
      "7:column:0",
      null,
      [
        "S005"
      ]
    ],
    [
      "P026",
      "Avoid any danger to\npersons or the environment when repairing water leakage, draining water and discharging\nair.",
      false,
      "prose",
      "7:column:0",
      null,
      [
        "S005"
      ]
    ],
    [
      "P027",
      "It is strongly suggested that an air leakage pan shall be placed under the pump.",
      false,
      "prose",
      "7:column:0",
      null,
      [
        "S005"
      ]
    ],
    [
      "P028",
      "Warning\nOnce work is done, immediately re-install and/or re-start all safety-related protective\ndevices.",
      false,
      "prose",
      "7:column:0",
      null,
      [
        "S005"
      ]
    ],
