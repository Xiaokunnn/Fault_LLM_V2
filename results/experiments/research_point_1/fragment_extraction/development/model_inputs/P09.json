  "paragraphs": [
    [
      "P001",
      "OM--04760",
      false,
      "heading",
      "5:column:0",
      null,
      []
    ],
    [
      "P002",
      "to a boil, build pressure, and cause the\npump casing to rupture or explode.",
      false,
      "prose",
      "5:column:0",
      null,
      [
        "S001"
      ]
    ],
    [
      "P003",
      "Do not remove plates, covers, gauges,\npipe plugs, or fittings from an overheated pump.",
      false,
      "prose",
      "5:column:0",
      null,
      [
        "S001"
      ]
    ],
    [
      "P004",
      "Vapor pressure within the\npump can cause parts being disengaged to be ejected with great force.",
      false,
      "prose",
      "5:column:0",
      null,
      [
        "S001"
      ]
    ],
    [
      "P005",
      "Allow the pump to cool before servicing.",
      false,
      "prose",
      "5:column:0",
      null,
      [
        "S001"
      ]
    ],
    [
      "P006",
      "These pumps may be used to handle\nproducts which if overheated could produce dangerous fumes.",
      false,
      "prose",
      "5:column:0",
      null,
      [
        "S001"
      ]
    ],
    [
      "P007",
      "Use extreme\ncaution when venting the pump, or\nwhen removing covers, plates, plugs, or\nfittings.",
      false,
      "prose",
      "5:column:0",
      null,
      [
        "S001"
      ]
    ],
    [
      "P008",
      "Never run this pump backwards.",
      false,
      "prose",
      "5:column:0",
      null,
      [
        "S001"
      ]
    ],
    [
      "P009",
      "Be certain that rotation is correct before fully\nengaging the pump.",
      false,
      "prose",
      "5:column:0",
      null,
      [
        "S001"
      ]
    ],
    [
      "P010",
      "If the pump is used to pump materials\nwhich could cause serious illness or injury through direct exposure or emitted\nfumes, wear protective clothing, such\nasrubbergloves,face mask, andrubber\napron, as necessary before disassembling the pump or piping.",
      false,
      "prose",
      "5:column:0",
      null,
      [
        "S001"
      ]
    ],
    [
      "P011",
      "Do not operate the pump without\nshields and/or guards in place over the\ndrive shafts, belts, and/or couplings, or\nother rotating parts.",
      false,
      "prose",
      "5:column:0",
      null,
      [
        "S001"
      ]
    ],
    [
      "P012",
      "Exposed rotating\nPAGE A -- 2",
      false,
      "prose",
      "5:column:0",
      null,
      [
        "S001"
      ]
    ],
    [
      "P013",
      "SELF-PRIMING CENTRIFUAL PUMPS",
      false,
      "heading",
      "5:column:1",
      null,
      []
    ],
    [
      "P014",
      "parts can catch clothing, fingers, or\ntools, causing severe injury to personnel.",
      false,
      "prose",
      "5:column:1",
      null,
      [
        "S002"
      ]
    ],
    [
      "P015",
      "If the pump is powered by an electric\nmotor, do not operate a non-explosion\nproof motor in an explosive atmosphere.",
      false,
      "prose",
      "5:column:1",
      null,
      [
        "S002"
      ]
    ],
    [
      "P016",
      "An explosion, which may cause\nsevere personal injury or death, could\nresult.",
      false,
      "prose",
      "5:column:1",
      null,
      [
        "S002"
      ]
    ],
    [
      "P017",
      "Install, connect and operate the\nmotor in accordance with the National\nElectric Code and all local codes.",
      false,
      "prose",
      "5:column:1",
      null,
      [
        "S002"
      ]
    ],
    [
      "P018",
      "If\nthere is a conflict between the instructions in the manual accompanying the\nunit and the National Electric Code or\napplicable local code, the National or\nLocal code shall take precedence.",
      false,
      "prose",
      "5:column:1",
      null,
      [
        "S002"
      ]
    ],
    [
      "P019",
      "All\nelectrical equipment supplied with the\npump conforms to applicable federal\nregulations and national codes in effect\non the date of manufacture.",
      false,
      "prose",
      "5:column:1",
      null,
      [
        "S002"
      ]
    ],
    [
      "P020",
      "If the pump is electric motor driven, the\nelectrical power used to operate this\npump is high enough to cause injury or\ndeath.",
      false,
      "prose",
      "5:column:1",
      null,
      [
        "S002"
      ]
    ],
    [
      "P021",
      "Obtain the services of a qualified\nelectrician to troubleshoot, test and/or\nservice the electrical components of\nthis pump.",
      false,
      "prose",
      "5:column:1",
      null,
      [
        "S002"
      ]
    ],
    [
      "P022",
      "If the pump is powered by an internal\ncombustion engine, do not operate in\nan explosive atmosphere.",
      false,
      "prose",
      "5:column:1",
      null,
      [
        "S002"
      ]
    ],
    [
      "P023",
      "When operating internal combustion engines in an\nenclosed area, make certain that exhaust fumes are piped to the outside.",
      false,
      "prose",
      "5:column:1",
      null,
      [
        "S002"
      ]
    ],
    [
      "P024",
      "These fumes contain carbon monoxide,\na deadly gas that is colorless, tasteless,\nand odorless.",
      false,
      "prose",
      "5:column:1",
      null,
      [
        "S002"
      ]
    ],
    [
      "P025",
      "SAFETY",
      false,
      "heading",
      "5:column:1",
      null,
      [
        "S002"
      ]
    ],
    [
      "P026",
      "SELF-PRIMING CENTRIFUGAL PUMPS",
      true,
      "heading",
      "6:column:0",
      null,
      []
    ],
    [
      "P027",
      "Fuel used by internal combustion engines presents an extreme explosion\nand fire hazard.",
      true,
      "prose",
      "6:column:0",
      null,
      [
        "S004"
      ]
    ],
    [
      "P028",
      "Make certain that all\nfuel lines are securely connected and\nfree of leaks.",
      true,
      "prose",
      "6:column:0",
      null,
      [
        "S004"
      ]
    ],
    [
      "P029",
      "Never refuel a hot or running engine.",
      true,
      "prose",
      "6:column:0",
      null,
      [
        "S004"
      ]
    ],
    [
      "P030",
      "Avoid overfilling the fuel\ntank.Always use the correcttype offuel.",
      true,
      "prose",
      "6:column:0",
      null,
      [
        "S004"
      ]
    ],
    [
      "P031",
      "Never tamper with the engine governor\nto gain more power.",
      true,
      "prose",
      "6:column:0",
      null,
      [
        "S004"
      ]
    ],
    [
      "P032",
      "The governor establishes safe operating limits thatshould\nnot be exceeded.",
      true,
      "prose",
      "6:column:0",
      null,
      [
        "S004"
      ]
    ],
    [
      "P033",
      "The maximum contin-",
      true,
      "prose",
      "6:column:0",
      null,
      [
        "S004"
      ]
    ],
    [
      "P034",
