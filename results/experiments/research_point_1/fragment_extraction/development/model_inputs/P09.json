      null,
      [
        "S006"
      ]
    ],
    [
      "P037",
      "Ifthe pump ispowered byan engine,the\nengine exhaust from this product contains chemicals known to the State of\nCalifornia to cause cancer, birth defects\nor other reproductive harm.",
      true,
