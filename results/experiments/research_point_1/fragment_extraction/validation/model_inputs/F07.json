      null,
      []
    ],
    [
      "P029",
      "(o)\nNavigation lights, aids and signals.",
      true,
      "prose",
      "736:column:0",
      null,
      []
    ],
    [
      "P030",
      "(p)\nInternal safety communication equipment.",
      true,
      "prose",
      "736:column:0",
      null,
      []
    ],
    [
      "P031",
      "(q)\nLighting system.",
      true,
      "prose",
      "736:column:0",
      null,
      []
    ],
    [
      "P032",
      "TABLE 2",
      true,
      "heading",
      "736:column:0",
      null,
      []
    ],
    [
      "P033",
      "Secondary Essential Services\n(a)\nWindlass\n(b)\nFuel oil transfer pumps and fuel oil treatment equipment\n(c)\nLubrication oil transfer pumps and lubrication oil treatment equipment\n(d)\nPre-heaters for heavy fuel oil\n(e)\nStarting air and control air compressors\n(f)\nBilge, ballast and heeling pumps\n(g)\nFire pumps and other fire extinguishing medium pumps\n(h)\nVentilating fans for engine and boiler rooms\n(i)\nServices considered necessary to maintain dangerous spaces in a safe condition (inert gas system of\nan oil carrier, ventilation for Ro-Ro cargo spaces, etc.)\n(j)\nMethods used to comply with 5C-8-7/1 on liquefied gas carriers\n(k)\nNavigation lights, aids and signals\n(k)\nInternal communication equipment required by 4-8-2/11.5\n(m)\nFire detection and alarm system\n(n)\nLighting system\n(o)\nElectrical equipment for watertight and fire-tight closing appliances\n(p)\nElectric generators and associated power sources supplying secondary essential equipment\n(q)\nHydraulic pumps supplying secondary essential equipment\n(r)\nControl, monitoring and safety systems for cargo containment systems\n(s)\nControl, monitoring and safety devices/systems of equipment for secondary essential services.",
      true,
      "prose",
      "736:column:0",
      null,
      [
        "S008"
      ]
    ],
    [
      "P034",
      "(t)\nAmbient temperature control equipment required by 4-8-3/1.17.2\n(u)\nWatertight Doors (see Section 3-2-9, 3-2-15 and 3-2-16)",
      true,
      "prose",
      "736:column:0",
      null,
      [
        "S008"
      ]
    ],
