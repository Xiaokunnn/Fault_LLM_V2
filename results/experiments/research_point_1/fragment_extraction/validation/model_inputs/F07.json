    ],
    [
      "P027",
      "(j)\nElectric generators and associated power sources supplying primary essential equipment\n(k)\nHydraulic pumps supplying primary essential equipment\n(l)\nViscosity control equipment for heavy fuel oil\n(m)\nControl, monitoring and safety devices/systems of equipment for primary essential services.",
      true,
      "prose",
      "736:column:0",
      null,
      []
    ],
    [
      "P028",
      "(n)\nFire pumps and other fire extinguishing medium pumps.",
      true,
      "prose",
