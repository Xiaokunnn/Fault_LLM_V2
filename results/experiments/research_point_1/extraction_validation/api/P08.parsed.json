{
  "contexts": [
    {
      "context_id": "ctx_disassembly_26A_29A",
      "kind": "procedure",
      "qualifier_evidence": [
        {
          "unit_id": "MP018:p0022:b0000",
          "quote": "26A Thrust bearings (18) can be removed by WORKING AGAINST THE INNER RACE OF THE"
        },
        {
          "unit_id": "MP018:p0022:b0001",
          "quote": "INNER MOST BEARING. (Refer to Figure 6)"
        },
        {
          "unit_id": "MP018:p0022:b0002",
          "quote": "WARNING ! ! Failure to use this procedure can damage the bearing."
        },
        {
          "unit_id": "MP018:p0022:b0003",
          "quote": "27A Slide thrust bearing cartridge (141) off shaft."
        },
        {
          "unit_id": "MP018:p0022:b0004",
          "quote": "28A"
        },
        {
          "unit_id": "MP018:p0022:b0005",
          "quote": "If pump was provided with grease seals (51) for the thrust (37) and radial (35) bearing covers and"
        },
        {
          "unit_id": "MP018:p0022:b0006",
          "quote": "the thrust bearing cartridge (141) these should be inspected for any visible damage and replaced,"
        },
        {
          "unit_id": "MP018:p0022:b0007",
          "quote": "if necessary."
        },
        {
          "unit_id": "MP018:p0022:b0008",
          "quote": "29A Pump is now completely disassembled with the exception of the wear rings (8 & 25) and stuffing"
        },
        {
          "unit_id": "MP018:p0022:b0009",
          "quote": "box bushing (15 & 27, if supplied). All of these items have an interference fit with their respective"
        },
        {
          "unit_id": "MP018:p0022:b0010",
          "quote": "pieces. To disassemble, remove their respective locking devices and pry out working uniformly at"
        },
        {
          "unit_id": "MP018:p0022:b0011",
          "quote": "180° points."
        },
        {
          "unit_id": "MP018:p0022:b0012",
          "quote": "NOTE: Wear rings and stuffing box bushings should not be removed unless it is necessary to replace"
        },
        {
          "unit_id": "MP018:p0022:b0013",
          "quote": "them with new parts."
        }
      ],
      "conditions_zh": [
        "泵已按前页步骤拆解至推力轴承拆卸阶段",
        "若泵配备油脂密封(51)",
        "耐磨环和填料箱衬套为过盈配合"
      ],
      "applicability_zh": "Non-Clog离心泵完全拆解程序步骤26A至29A",
      "branch": {
        "fault_ids": [],
        "cause_ids": [],
        "action_ids": []
      }
    }
  ],
