    {
      "context_id": "ctx_work_range_general",
      "kind": "prose",
      "qualifier_evidence": [
        {
          "unit_id": "MP005:p0022:b0002",
          "quote": "4.1. Work range"
        },
        {
          "unit_id": "MP005:p0022:b0003",
          "quote": "The working range depends on the basic hydraulic design, the type of connection and sealings."
        },
        {
          "unit_id": "MP005:p0022:b0004",
          "quote": "The module in the pumps with the strictest specification determines the allowable pressure and"
        },
        {
          "unit_id": "MP005:p0022:b0005",
          "quote": "temperature of the medium in the pumps. Pumps with ATEX (explosion safety) marking, which are"
        }
      ],
      "conditions_zh": [
        "ATEX防爆标志泵在爆炸性危险环境中使用时介质温度有额外限制"
      ],
      "applicability_zh": "DESMI NSL船用离心泵工作范围通用规范",
      "branch": {
        "fault_ids": [],
        "cause_ids": [],
        "action_ids": []
      }
    },
    {
      "context_id": "ctx_media_temp_limits",
      "kind": "prose",
      "qualifier_evidence": [
        {
          "unit_id": "MP005:p0022:b0008",
          "quote": "Media temperature range for:"
        },
        {
          "unit_id": "MP005:p0022:b0009",
          "quote": "Lower limit temperature: - 20°C (minus 40°C for brine pumps in ductile iron with spec. seal)"
        },
        {
          "unit_id": "MP005:p0022:b0010",
          "quote": "Upper limit temperature: +80°C for fresh water (up to 150°C with special shaft seal),"
        },
        {
          "unit_id": "MP005:p0022:b0011",
          "quote": "+40°C for sea water (up to +60°C seawater in Super Duplex pumps"
        },
        {
          "unit_id": "MP005:p0022:b0012",
          "quote": "with special shaft seal)"
        }
      ],
      "conditions_zh": [
        "球墨铸铁盐水泵配特殊密封时下限为-40°C",
        "淡水配特殊轴封时上限可达150°C",
        "Super Duplex海水泵配特殊轴封时上限可达+60°C"
      ],
      "applicability_zh": "NSL泵输送不同介质时的温度限值",
      "branch": {
        "fault_ids": [],
        "cause_ids": [],
        "action_ids": []
      }
    },
    {
      "context_id": "ctx_fresh_water_bearing_temp",
      "kind": "prose",
      "qualifier_evidence": [
        {
          "unit_id": "MP005:p0022:b0013",
          "quote": "(The pump is suitable for pumping of clean fresh water with temperatures up to 100 C when ball bearing mounted on"
        },
        {
          "unit_id": "MP005:p0022:b0014",
          "quote": "pump shaft, and up to 140 C when without ball bearing mounted on pump shaft. For pumping of clean fresh water with"
        },
        {
          "unit_id": "MP005:p0022:b0015",
          "quote": "temperatures above 100 C, DESMI only delivers ductile iron (for instance GGG40) or martensitic stainless steel (for"
        },
        {
          "unit_id": "MP005:p0022:b0016",
          "quote": "instance 1.4436) for pump casing and rear cover.)"
        }
      ],
      "conditions_zh": [
        "仅适用于清洁淡水",
        "泵轴上安装球轴承时最高100°C",
        "泵轴上不安装球轴承时最高140°C",
        "超过100°C时泵壳和后盖必须使用球墨铸铁(GGG40)或马氏体不锈钢(1.4436)"
      ],
      "applicability_zh": "NSL泵输送清洁淡水时基于轴承配置和壳体材料的温度适用条件",
      "branch": {
        "fault_ids": [],
        "cause_ids": [],
        "action_ids": []
      }
    },
    {
      "context_id": "ctx_ambient_temp_limits",
      "kind": "prose",
      "qualifier_evidence": [
        {
          "unit_id": "MP005:p0022:b0017",
          "quote": "Ambient temperature range for:"
        },
        {
          "unit_id": "MP005:p0022:b0018",
          "quote": "Lower limit temperature: - 20 °C"
        },
        {
          "unit_id": "MP005:p0022:b0019",
          "quote": "Upper limit temperature: + 45 °C"
        },
        {
          "unit_id": "MP005:p0022:b0020",
          "quote": "(1. Avoid freezing the pump."
        },
        {
          "unit_id": "MP005:p0022:b0021",
          "quote": "2. If the ambient temperature exceeds the above value or the motor is located more than 1000 m above sea level, the"
        },
        {
          "unit_id": "MP005:p0022:b0022",
          "quote": "motor cooling is less effective and could require an adapted motor power. Please contact your supplier for more detailed"
        },
        {
          "unit_id": "MP005:p0022:b0023",
          "quote": "advice.)"
        }
      ],
      "conditions_zh": [
        "环境温度超过+45°C或电机海拔超过1000m时冷却效果降低",
        "需避免泵冻结"
      ],
      "applicability_zh": "NSL泵运行环境温度限值及超限影响",
      "branch": {
        "fault_ids": [],
        "cause_ids": [],
        "action_ids": []
      }
    },
    {
      "context_id": "ctx_media_density_viscosity",
      "kind": "prose",
      "qualifier_evidence": [
        {
          "unit_id": "MP005:p0022:b0024",
          "quote": "Media density and viscosity"
        },
        {
          "unit_id": "MP005:p0022:b0025",
          "quote": "Density: Max. 2500 kg/m3"
        },
        {
          "unit_id": "MP005:p0022:b0026",
          "quote": "Viscosity: Max. 500 cSt."
        },
        {
          "unit_id": "MP005:p0022:b0027",
          "quote": "(Pumping liquids with a higher density and/or viscosity than water requires more mechanical torque from pump shaft and"
        },
        {
          "unit_id": "MP005:p0022:b0028",
          "quote": "more power from the electric motor. This could cause overloading of the pump shaft and motor. Contact your supplier for"
        },
        {
          "unit_id": "MP005:p0022:b0029",
          "quote": "advice, if needed.)"
        }
      ],
      "conditions_zh": [
        "密度最大2500 kg/m³",
        "粘度最大500 cSt",
        "高于水的密度或粘度需要更大机械扭矩和电机功率"
      ],
      "applicability_zh": "NSL泵输送介质的密度和粘度限值及超载风险",
      "branch": {
        "fault_ids": [],
        "cause_ids": [],
        "action_ids": []
      }
