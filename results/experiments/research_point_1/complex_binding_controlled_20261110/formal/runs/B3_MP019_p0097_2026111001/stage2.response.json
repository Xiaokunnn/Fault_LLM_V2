{
  "content": "{\n  \"triples\": [\n    {\n      \"head_surface\": \"isolationsresistansen, korrigerad till 25°C, måste överstiga referensvärdet, dvs. 100 MΩ (mätt med 500 eller 1000 V DC)\",\n      \"head_canonical_zh\": \"绝缘电阻值\",\n      \"head_type\": \"Component\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"电机\",\n      \"tail_canonical_zh\": \"电机\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"Isolationsresistansen, korrigerad till 25°C, måste överstiga referensvärdet, dvs. 100 MΩ (mätt med 500 eller 1000 V DC).\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"structural_context\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"电机外壳必须接地和屏蔽\",\n      \"head_canonical_zh\": \"电机外壳\",\n      \"head_type\": \"Component\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"电机\",\n      \"tail_canonical_zh\": \"电机\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"Motorhöljet måste vara jordat och lindningarna måste laddas ur mot höljet omedelbart efter varje mätning så att risken för elektriska stötar undviks.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"structural_context\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"如果参考电阻值无法达到\",\n      \"head_canonical_zh\": \"参考电阻值\",\n      \"head_type\": \"Component\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"电机\",\n      \"tail_canonical_zh\": \"电机\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"Om referensresistansen inte kan uppnås är lindningen fuktig och måste torkas i ugn. Ugnstemperaturen skall vara 90°C under 12-16 timmar, följt av 105 °C under 6-8 timmar.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"structural_context\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"如果存在排水孔中的插头\",\n      \"head_canonical_zh\": \"排水孔中的插头\",\n      \"head_type\": \"Component\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"电机\",\n      \"tail_canonical_zh\": \"电机\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"Om det finns pluggar i dräneringshålen måste dessa tas ur och stängningsventiler, om sådana finns, måste vara öppna under uppvärmningen.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"structural_context\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"如果轴承类型在铭牌上标注\",\n      \"head_canonical_zh\": \"轴承类型\",\n      \"head_type\": \"Component\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"电机\",\n      \"tail_canonical_zh\": \"电机\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"Lagertypen anges på märkskylten.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"structural_context\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"如果电机安装时轴向上有液体\",\n      \"head_canonical_zh\": \"液体\",\n      \"head_type\": \"Component\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"电机\",\n      \"tail_canonical_zh\": \"电机\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"Om en motor monteras med axeln uppåt för och vätska kan förväntas rinna ned utefrån axeln måste användaren vidta åtgärder för att förhindra detta.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"structural_context\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"如果电机安装在没有径向负载的情况下\",\n      \"head_canonical_zh\": \"径向负载\",\n      \"head_type\": \"Component\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"电机\",\n      \"tail_canonical_zh\": \"电机\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"Om motorn körs utan radiell belastning på axeln kan rullagret skadas.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"structural_context\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"如果电机安装在没有轴向力作用的情况下\",\n      \"head_canonical_zh\": \"轴向力\",\n      \"head_type\": \"Component\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"电机\",\n      \"tail_canonical_zh\": \"电机\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"Om motorn körs utan axiell kraft tillämpad i rätt riktning i förhållande till axeln kan vinkelkontaktlagret skadas.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"structural_context\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    }\n  ],\n  \"warnings\": []\n}",
