{
  "content": "{\n  \"triples\": [\n    {\n      \"head_surface\": \"Osservare la pompa durante le prime ore di funziona-mento verificando che non ci siano rumori insoliti e che la pompa non sia eccessivamente surriscaldata.\",\n      \"head_canonical_zh\": \"检查泵在启动后的最初几个小时内是否发出异常声音以及泵是否过热\",\n      \"head_type\": \"InspectionAction\",\n      \"relation\": \"performs\",\n      \"tail_surface\": \"Pompa\",\n      \"tail_canonical_zh\": \"泵\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"Osservare la pompa durante le prime ore di funziona-mento verificando che non ci siano rumori insoliti e che la pompa non sia eccessivamente surriscaldata.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Se utilizzata a velocità elevate o con liquidi caldi, la superficie della pompa può riscaldarsi.\",\n      \"head_canonical_zh\": \"如果泵以高速运行或处理热水，泵表面可能会变热\",\n      \"head_type\": \"Component\",\n      \"relation\": \"can\",\n      \"tail_surface\": \"Pompa\",\n      \"tail_canonical_zh\": \"泵\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"Se utilizzata a velocità elevate o con liquidi caldi, la superficie della pompa può riscaldarsi.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [\"TemperatureIncrease\"],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Non utilizzare detergenti a base di iodio e fosforo perché queste sostanze aggrediscono la pompa e riducono le sue prestazioni.\",\n      \"head_canonical_zh\": \"不要使用含碘和磷的清洁剂，因为这些物质会损害泵并降低其性能\",\n      \"head_type\": \"Standard\",\n      \"relation\": \"specifies\",\n      \"tail_surface\": \"Detergenti a base di iodio e fosforo\",\n      \"tail_canonical_zh\": \"含碘和磷的清洁剂\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"Non utilizzare detergenti a base di iodio e fosforo perché queste sostanze aggrediscono la pompa e riducono le sue prestazioni.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Verificare che non ci siano vibrazioni o variazioni di temperatura insolite.\",\n      \"head_canonical_zh\": \"检查是否存在异常的振动或温度变化\",\n      \"head_type\": \"InspectionAction\",\n      \"relation\": \"performs\",\n      \"tail_surface\": \"Pompa\",\n      \"tail_canonical_zh\": \"泵\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"Verificare che non ci siano vibrazioni o variazioni di temperatura insolite.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [\"Vibration\", \"TemperatureVariation\"],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Ispezionare visivamente la girante verificando che non sia danneggiata o usurata e controllare che l'alloggiamento delle tenute non presenti perdite.\",\n      \"head_canonical_zh\": \"检查旋转部件是否损坏或磨损，并检查密封件是否有泄漏\",\n      \"head_type\": \"InspectionAction\",\n      \"relation\": \"performs\",\n      \"tail_surface\": \"Pompa\",\n      \"tail_canonical_zh\": \"泵\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"Ispezionare visivamente la girante verificando che non sia danneggiata o usurata e controllare che l'alloggiamento delle tenute non presenti perdite.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [\"WearAndTear\", \"Leakage\"],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Sostituire l'o-ring o la guarnizione della copertura terminale.\",\n      \"head_canonical_zh\": \"更换端盖密封圈\",\n      \"head_type\": \"MaintenanceAction\",\n      \"relation\": \"performs\",\n      \"tail_surface\": \"O-ring o la guarnizione della copertura terminale\",\n      \"tail_canonical_zh\": \"端盖密封圈\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"Sostituire l'o-ring o la guarnizione della copertura terminale.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"maintenance\",\n      \"fault_class_ids\": [\"WearAndTear\"],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Rimuovere la girante utilizzando lo strumento di rimozione della girante Jabsco della dimensione corretta.\",\n      \"head_canonical_zh\": \"使用正确的Jabsco拆卸工具拆卸旋转部件\",\n      \"head_type\": \"MaintenanceAction\",\n      \"relation\": \"performs\",\n      \"tail_surface\": \"Girante\",\n      \"tail_canonical_zh\": \"旋转部件\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"Rimuovere la girante utilizzando lo strumento di rimozione della girante Jabsco della dimensione corretta.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"maintenance\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Rimuovere la copertura terminale, verificare che la pompa e l’unità di azionamento siano isolate, la temperatura della pompa sia sufficientemente bassa da poter essere toccata, tutti i liquidi pericolosi siano stati scaricati (prestare particolare attenzione ai liquidi pericolosi), quindi verificare che la pompa e il sistema di lavaggio delle tenute siano isolati e depressurizzati.\",\n      \"head_canonical_zh\": \"移除端盖，确保泵和驱动单元已隔离，泵的温度足够低可以触摸，所有危险液体已排放（特别注意危险液体），然后确保泵和密封冲洗系统的隔离和泄压\",\n      \"head_type\": \"MaintenanceAction\",\n      \"relation\": \"performs\",\n      \"tail_surface\": \"Copertura terminale\",\n      \"tail_canonical_zh\": \"端盖\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"Rimuovere la copertura terminale, verificare che la pompa e l’unità di azionamento siano isolate, la temperatura della pompa sia sufficientemente bassa da poter essere toccata, tutti i liquidi pericolosi siano stati scaricati (prestare particolare attenzione ai liquidi pericolosi), quindi verificare che la pompa e il sistema di lavaggio delle tenute siano isolati e depressurizzati.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"maintenance\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    }\n  ],\n  \"warnings\": []\n}",
