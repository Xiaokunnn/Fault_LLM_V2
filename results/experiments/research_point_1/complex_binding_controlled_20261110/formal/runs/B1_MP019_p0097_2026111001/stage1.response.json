{
  "content": "{\n  \"triples\": [\n    {\n      \"head_surface\": \"isolationsresistansen, korrigerad till 25°C, måste överstiga referensvärdet, dvs. 100 MΩ (mätt med 500 eller 1000 V DC)\",\n      \"head_canonical_zh\": \"绝缘电阻值，调整至25°C，应超过参考值，即100 MΩ（用500或1000V DC测量）\",\n      \"head_type\": \"Standard\",\n      \"relation\": \"specified_by\",\n      \"tail_surface\": \"ABB/Manual for Low Voltage Motors 01-2009\",\n      \"tail_canonical_zh\": \"ABB/低压电机手册 01-2009\",\n      \"tail_type\": \"Standard\",\n      \"evidence_text\": \"Isolationsresistansen, korrigerad till 25°C, måste överstiga referensvärdet, dvs. 100 MΩ (mätt med 500 eller 1000 V DC).\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"motorhöljet måste vara jordat och lindningarna måste laddas ur mot höljet omedelbart efter varje mätning så att risken för elektriska stötar undviks\",\n      \"head_canonical_zh\": \"电机外壳必须接地，并且每次测量后必须立即从外壳移除电缆以避免触电风险\",\n      \"head_type\": \"Standard\",\n      \"relation\": \"specified_by\",\n      \"tail_surface\": \"ABB/Manual for Low Voltage Motors 01-2009\",\n      \"tail_canonical_zh\": \"ABB/低压电机手册 01-2009\",\n      \"tail_type\": \"Standard\",\n      \"evidence_text\": \"Motorhöljet måste vara jordat och lindningarna måste laddas ur mot höljet omedelbart efter varje mätning så att risken för elektriska stötar undviks.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"om referensresistansen inte kan uppnås är lindningen fuktig och måste torkas i ugn\",\n      \"head_canonical_zh\": \"如果参考电阻值无法达到，则电缆潮湿，需要在烤箱中干燥\",\n      \"head_type\": \"Symptom\",\n      \"relation\": \"indicates\",\n      \"tail_surface\": \"lindningen är fuktig\",\n      \"tail_canonical_zh\": \"电缆潮湿\",\n      \"tail_type\": \"FaultMode\",\n      \"evidence_text\": \"Om referensresistansen inte kan uppnås är lindningen fuktig och måste torkas i ugn.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [\"Wet_cable\"],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"lindningen måste torkas i ugn\",\n      \"head_canonical_zh\": \"电缆必须在烤箱中干燥\",\n      \"head_type\": \"MaintenanceAction\",\n      \"relation\": \"performed_to_prevent\",\n      \"tail_surface\": \"lindningen är fuktig\",\n      \"tail_canonical_zh\": \"电缆潮湿\",\n      \"tail_type\": \"FaultMode\",\n      \"evidence_text\": \"Om referensresistansen inte kan uppnås är lindningen fuktig och måste torkas i ugn.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"maintenance\",\n      \"fault_class_ids\": [\"Wet_cable\"],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"om det finns pluggar i dräneringshålen måste dessa tas ur\",\n      \"head_canonical_zh\": \"如果排水孔中有插头，则必须将其拔出\",\n      \"head_type\": \"InspectionAction\",\n      \"relation\": \"performed_to_inspect\",\n      \"tail_surface\": \"dräneringshål\",\n      \"tail_canonical_zh\": \"排水孔\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"Om det finns pluggar i dräneringshålen måste dessa tas ur och stängningsventiler, om sådana finns, måste vara öppna under uppvärmningen.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"dräneringspluggar finns rekommenderas att lagersköldarnas och uttagslådans lock monteras bort före uppvärmningen\",\n      \"head_canonical_zh\": \"如果存在排水插头，建议在加热前拆除存储柜锁和抽屉锁\",\n      \"head_type\": \"MaintenanceAction\",\n      \"relation\": \"performed_to_prevent\",\n      \"tail_surface\": \"lagersköldar och uttagslådans lock\",\n      \"tail_canonical_zh\": \"存储柜锁和抽屉锁\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"Om det finns pluggar i dräneringshålen måste dessa tas ur och stängningsventiler, om sådana finns, måste vara öppna under uppvärmningen. Kom ihåg att sätta tillbaka pluggarna efter värmningen. Även om dräneringspluggar finns rekommenderas att lagersköldarnas och uttagslådans lock monteras bort före uppvärmningen.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"maintenance\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"lagersköldar och uttagslådans lock monteras bort före uppvärmningen\",\n      \"head_canonical_zh\": \"在加热前拆除存储柜锁和抽屉锁\",\n      \"head_type\": \"MaintenanceAction\",\n      \"relation\": \"performed_to_prevent\",\n      \"tail_surface\": \"lagersköldar och uttagslådans lock\",\n      \"tail_canonical_zh\": \"存储柜锁和抽屉锁\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"Om det finns pluggar i dräneringshålen måste dessa tas ur och stängningsventiler, om sådana finns, måste vara öppna under uppvärmningen. Kom ihåg att sätta tillbaka pluggarna efter värmningen. Även om dräneringspluggar finns rekommenderas att lagersköldarnas och uttagslådans lock monteras bort före uppvärmningen.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"maintenance\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"dräneringspluggar finns\",\n      \"head_canonical_zh\": \"存在排水插头\",\n      \"head_type\": \"FaultMode\",\n      \"relation\": \"manifests_as\",\n      \"tail_surface\": \"lagersköldar och uttagslådans lock monteras bort före uppvärmningen\",\n      \"tail_canonical_zh\": \"在加热前拆除存储柜锁和抽屉锁\",\n      \"tail_type\": \"MaintenanceAction\",\n      \"evidence_text\": \"Om det finns pluggar i dräneringshålen måste dessa tas ur och stängningsventiler, om sådana finns, måste vara öppna under uppvärmningen. Kom ihåg att sätta tillbaka pluggarna efter värmningen. Även om dräneringspluggar finns rekommenderas att lagersköldarnas och uttagslådans lock monteras bort före uppvärmningen.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [\"Drain_plugs_exist\"],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"dräneringspluggar finns\",\n      \"head_canonical_zh\": \"存在排水插头\",\n      \"head_type\": \"FaultMode\",\n      \"relation\": \"manifests_as\",\n      \"tail_surface\": \"lagersköldar och uttagslådans lock monteras bort före uppvärmningen\",\n      \"tail_canonical_zh\": \"在加热前拆除存储柜锁和抽屉锁\",\n      \"tail_type\": \"MaintenanceAction\",\n      \"evidence_text\": \"Om det finns pluggar i dräneringshålen måste dessa tas ur och stängningsventiler, om sådana finns, måste vara öppna under uppvärmningen. Kom ihåg att sätta tillbaka pluggarna efter värmningen. Även om dräneringspluggar finns rekommenderas att lagersköldarnas och uttagslådans lock monteras bort före uppvärmningen.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [\"Drain_plugs_exist\"],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    }\n  ],\n  \"warnings\": []\n}",
