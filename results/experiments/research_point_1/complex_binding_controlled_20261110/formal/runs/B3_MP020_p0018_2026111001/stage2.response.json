  "content": "{\n  \"triples\": [\n    {\n      \"head_surface\": \"The pump must be filled with liquid before it is started.\",\n      \"head_canonical_zh\": \"泵必须在启动前充满液体\",\n      \"head_type\": \"InspectionAction\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"PRIMING METHODS\",\n      \"tail_canonical_zh\": \"灌泵方法\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"The pump must be filled with liquid before it is started.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    },\n    {\n      \"head_surface\": \"Automatic priming is used for unattended operation.\",\n      \"head_canonical_zh\": \"自动灌泵用于无人操作\",\n      \"head_type\": \"InspectionAction\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"PRIMING METHODS\",\n      \"tail_canonical_zh\": \"灌泵方法\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"Automatic priming is used for unattended operation.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    },\n    {\n      \"head_surface\": \"Electric sensing and controls prime the unit before start-up.\",\n      \"head_canonical_zh\": \"电感测和控制在启动前灌泵\",\n      \"head_type\": \"InspectionAction\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"PRIMING METHODS\",\n      \"tail_canonical_zh\": \"灌泵方法\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"Electric sensing and controls prime the unit before start-up.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    },\n    {\n      \"head_surface\": \"There is no water carry-over.\",\n      \"head_canonical_zh\": \"没有水携带过\",\n      \"head_type\": \"InspectionAction\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"PRIMING METHODS\",\n      \"tail_canonical_zh\": \"灌泵方法\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"There is no water carry-over.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    },\n    {\n      \"head_surface\": \"Cornell Redi-Prime, fully automated, self-priming pumps are ideal for unattended operation.\",\n      \"head_canonical_zh\": \"Cornell Redi-Prime，全自动自灌泵适用于无人操作\",\n      \"head_type\": \"InspectionAction\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"PRIMING METHODS\",\n      \"tail_canonical_zh\": \"灌泵方法\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"Cornell Redi-Prime, fully automated, self-priming pumps are ideal for unattended operation.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    },\n    {\n      \"head_surface\": \"Our positive sealing float box and diaphragm vacuum pump configuration insures that there is no water carry-over.\",\n      \"head_canonical_zh\": \"我们的正密封浮筒箱和隔膜真空泵配置确保没有水携带过\",\n      \"head_type\": \"InspectionAction\",\n      \"relation\": 