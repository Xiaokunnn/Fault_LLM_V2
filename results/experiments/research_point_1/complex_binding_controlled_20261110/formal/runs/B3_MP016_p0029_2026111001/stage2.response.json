{
  "content": "{\n  \"triples\": [\n    {\n      \"head_surface\": \"Osservare la pompa durante le prime ore di funziona- È possibile lavare rapidamente la pompa per accedere rapida-\\n     mento alle superfici a contatto con il liquido per poterla pulire\\n     manualmente o ispezionarla se necessario.\",\n      \"head_canonical_zh\": \"观察泵在启动初期，快速清洗泵以接触液体的表面\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"pompa\",\n      \"tail_canonical_zh\": \"泵\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"Osservare la pompa durante le prime ore di funziona- È possibile lavare rapidamente la pompa per accedere rapida-\\n     mento alle superfici a contatto con il liquido per poterla pulire\\n     manualmente o ispezionarla se necessario.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Se utilizzata a velocità elevate o con liquidi caldi, la superficie della pompa può riscaldarsi.\",\n      \"head_canonical_zh\": \"如果泵以高速运行或使用热水，泵表面可能会变热\",\n      \"head_type\": \"OperatingCondition\",\n      \"relation\": \"causes\",\n      \"tail_surface\": \"superficie della pompa può riscaldarsi\",\n      \"tail_canonical_zh\": \"泵表面可能会变热\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"Se utilizzata a velocità elevate o con liquidi caldi, la superficie della pompa può riscaldarsi.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Non utilizzare detergenti a base di iodio e fosforo perché queste sostanze aggrediscono la pompa e riducono le sue prestazioni.\",\n      \"head_canonical_zh\": \"不要使用含碘和磷的清洁剂，因为这些物质会损害泵并降低其性能\",\n      \"head_type\": \"Standard\",\n      \"relation\": \"prevented_by\",\n      \"tail_surface\": \"utilizzare detergenti a base di iodio e fosforo\",\n      \"tail_canonical_zh\": \"使用含碘和磷的清洁剂\",\n      \"tail_type\": \"MaintenanceAction\",\n      \"evidence_text\": \"Non utilizzare detergenti a base di iodio e fosforo perché queste sostanze aggrediscono la pompa e riducono le sue prestazioni.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"maintenance\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Verificare che non ci siano rumori insoliti.\",\n      \"head_canonical_zh\": \"检查是否有异常噪音\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"indicates\",\n      \"tail_surface\": \"rumori insoliti\",\n      \"tail_canonical_zh\": \"异常噪音\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"Verificare che non ci siano rumori insoliti.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Controllare che non ci siano vibrazioni o variazioni di temperatura insolite.\",\n      \"head_canonical_zh\": \"检查是否有异常振动或温度变化\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"indicates\",\n      \"tail_surface\": \"vibrazioni o variazioni di temperatura insolite\",\n      \"tail_canonical_zh\": \"异常振动或温度变化\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"Controllare che non ci siano vibrazioni o variazioni di temperatura insolite.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Ispezionare visivamente la girante verificando che non sia danneggiata o usurata e controllare che l'alloggiamento delle tenute non presenti perdite.\",\n      \"head_canonical_zh\": \"目视检查旋转部件是否损坏或磨损，并检查密封件是否有泄漏\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"inspected_by\",\n      \"tail_surface\": \"girante\",\n      \"tail_canonical_zh\": \"旋转部件\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"Ispezionare visivamente la girante verificando che non sia danneggiata o usurata e controllare che l'alloggiamento delle tenute non presenti perdite.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Sostituire l'o-ring o la guarnizione della copertura terminale.\",\n      \"head_canonical_zh\": \"更换端盖密封圈\",\n      \"head_type\": \"MaintenanceAction\",\n      \"relation\": \"prevented_by\",\n      \"tail_surface\": \"usura o danneggiata\",\n      \"tail_canonical_zh\": \"磨损或损坏\",\n      \"tail_type\": \"FaultMode\",\n      \"evidence_text\": \"Sostituire l'o-ring o la guarnizione della copertura terminale.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"maintenance\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    }\n  ],\n  \"warnings\": []\n}",
