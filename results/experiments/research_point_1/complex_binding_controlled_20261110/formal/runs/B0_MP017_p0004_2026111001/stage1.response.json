{
  "content": "{\n  \"triples\": [\n    {\n      \"head_surface\": \"Check the temperature before opening any covers, plates, or plugs.\",\n      \"head_canonical_zh\": \"检查温度后再打开任何盖板、板或插头\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"inspected_by\",\n      \"tail_surface\": \"opening any covers, plates, or plugs.\",\n      \"tail_canonical_zh\": \"打开任何盖板、板或插头\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"Check the temperature before opening any covers, plates, or plugs.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"Close the suction and discharge valves.\",\n      \"head_canonical_zh\": \"关闭吸入和排出阀\",\n      \"head_type\": \"InspectionAction\",\n      \"relation\": \"inspected_by\",\n      \"tail_surface\": \"closing the suction and discharge valves.\",\n      \"tail_canonical_zh\": \"关闭吸入和排出阀\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"Close the suction and discharge valves.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"Vent the pump slowly and cautiously.\",\n      \"head_canonical_zh\": \"缓慢谨慎地排气\",\n      \"head_type\": \"InspectionAction\",\n      \"relation\": \"inspected_by\",\n      \"tail_surface\": \"venting the pump slowly and cautiously.\",\n      \"tail_canonical_zh\": \"缓慢谨慎地排气\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"Vent the pump slowly and cautiously.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"Drain the pump.\",\n      \"head_canonical_zh\": \"排空泵\",\n      \"head_type\": \"MaintenanceAction\",\n      \"relation\": \"maintained_by\",\n      \"tail_surface\": \"draining the pump.\",\n      \"tail_canonical_zh\": \"排空泵\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"Drain the pump.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"maintenance\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"Do not operate the pump against a closed discharge valve for long periods of time.\",\n      \"head_canonical_zh\": \"不要长时间让泵在关闭排出阀的情况下运行\",\n      \"head_type\": \"Risk\",\n      \"relation\": \"increases_risk_of\",\n      \"tail_surface\": \"pump components will deteriorate, and the liquid could come out of the pump.\",\n      \"tail_canonical_zh\": \"泵组件会损坏，液体可能会从泵中流出\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"Do not operate the pump against a closed discharge valve for long periods of time. If operated against a closed discharge valve, pump components will deteriorate, and the liquid could come out of the pump.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"risk\",\n      \"fault_class_ids\": [\"01\"],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"Suction and discharge hoses and piping must be removed from the pump before lifting.\",\n      \"head_canonical_zh\": \"提升前必须将吸入和排出软管及管道从泵上移除\",\n      \"head_type\": \"MaintenanceAction\",\n      \"relation\": \"maintained_by\",\n      \"tail_surface\": \"removing suction and discharge hoses and piping from the pump before lifting.\",\n      \"tail_canonical_zh\": \"提升前移除吸入和排出软管及管道\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"Suction and discharge hoses and piping must be removed from the pump before lifting.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"maintenance\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    }\n  ],\n  \"warnings\": []\n}",
