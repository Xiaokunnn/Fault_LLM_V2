{
  "content": "{\n  \"triples\": [\n    {\n      \"head_surface\": \"Osservare la pompa durante le prime ore di funziona-mento verificando che non ci siano rumori insoliti e che la pompa non sia eccessivamente surriscaldata\",\n      \"head_canonical_zh\": \"观察泵在启动初期确保没有异常噪音和过热现象\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"inspected_by\",\n      \"tail_surface\": \"Ispezionare visivamente tutti gli accoppiamenti e verificare che non ci siano segni di fuoriuscita di prodotto, liquido di lavaggio (se utilizzato)\",\n      \"tail_canonical_zh\": \"目视检查所有连接确保没有产品泄漏（如果使用了清洗液）\",\n      \"tail_type\": \"InspectionMethod\",\n      \"evidence_text\": \"Osservare la pompa durante le prime ore di funziona-mento verificando che non ci siano rumori insoliti e che la pompa non sia eccessivamente surriscaldata. Ispezionare visivamente tutti gli accoppiamenti e verificare che non ci siano segni di fuoriuscita di prodotto, liquido di lavaggio (se utilizzato).\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"Se utilizzata a velocità elevate o con liquidi caldi, la superficie della pompa può riscaldarsi\",\n      \"head_canonical_zh\": \"如果泵以高速运行或处理热水，泵表面可能会升温\",\n      \"head_type\": \"Symptom\",\n      \"relation\": \"manifests_as\",\n      \"tail_surface\": \"Superficie della pompa può riscaldarsi\",\n      \"tail_canonical_zh\": \"泵表面可能升温\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"Se utilizzata a velocità elevate o con liquidi caldi, la superficie della pompa può riscaldarsi.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"Non utilizzare detergenti a base di iodio e fosforo perché queste sostanze aggrediscono la pompa e riducono le sue prestazioni\",\n      \"head_canonical_zh\": \"不要使用含碘和磷的洗涤剂因为这些物质会损害泵并降低其性能\",\n      \"head_type\": \"Standard\",\n      \"relation\": \"specifies\",\n      \"tail_surface\": \"Non utilizzare detergenti a base di iodio e fosforo\",\n      \"tail_canonical_zh\": \"不要使用含碘和磷的洗涤剂\",\n      \"tail_type\": \"MaintenanceAction\",\n      \"evidence_text\": \"Non utilizzare detergenti a base di iodio e fosforo perché queste sostanze aggrediscono la pompa e riducono le sue prestazioni.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"Prima di rimuovere la copertura terminale, verificare che la pompa e l’unità di azionamento siano isolate, la temperatura della pompa sia sufficientemente bassa da poter essere toccata, tutti i liquidi pericolosi siano stati scaricati (prestare particolare attenzione ai liquidi pericolosi)\",\n      \"head_canonical_zh\": \"在移除终端盖之前，确保泵和驱动单元已隔离，泵温度足够低可以触摸，并且所有危险液体已被排放（特别注意危险液体）\",\n      \"head_type\": \"PreventiveAction\",\n      \"relation\": \"prevented_by\",\n      \"tail_surface\": \"rimuovere la copertura terminale\",\n      \"tail_canonical_zh\": \"移除终端盖\",\n      \"tail_type\": \"MaintenanceAction\",\n      \"evidence_text\": \"Prima di rimuovere la copertura terminale, verificare che la pompa e l’unità di azionamento siano isolate, la temperatura della pompa sia sufficientemente bassa da poter essere toccata, tutti i liquidi pericolosi siano stati scaricati (prestare particolare attenzione ai liquidi pericolosi).\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"prevention\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"Sostituire l’o-ring o la guarnizione della copertura terminale\",\n      \"head_canonical_zh\": \"更换终端盖的O型圈或密封圈\",\n      \"head_type\": \"MaintenanceAction\",\n      \"relation\": \"replaces\",\n      \"tail_surface\": \"o-ring o la guarnizione della copertura terminale\",\n      \"tail_canonical_zh\": \"O型圈或密封圈\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"Sostituire l’o-ring o la guarnizione della copertura terminale.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"maintenance\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"Controllare che il coperchio terminale si muova liberamente e, se è bloccato, picchiettare delicatamente lateralmente con un martello morbido, senza fare leva\",\n      \"head_canonical_zh\": \"检查终端盖是否能自由移动，若卡住则轻轻敲打侧面，但不要施加杠杆力\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"inspected_by\",\n      \"tail_surface\": \"Controllare che il coperchio terminale si muova liberamente e, se è bloccato, picchiettare delicatamente lateralmente con un martello morbido, senza fare leva\",\n      \"tail_canonical_zh\": \"检查终端盖是否能自由移动，若卡住则轻轻敲打侧面，但不要施加杠杆力\",\n      \"tail_type\": \"InspectionMethod\",\n      \"evidence_text\": \"Controllare che il coperchio terminale si muova liberamente e, se è bloccato, picchiettare delicatamente lateralmente con un martello morbido, senza fare leva.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"Rimuovere la girante utilizzando lo strumento di rimozione della girante Jabsco della dimensione corretta\",\n      \"head_canonical_zh\": \"使用正确尺寸的Jabsco拆卸工具移除转动件\",\n      \"head_type\": \"MaintenanceAction\",\n      \"relation\": \"uses\",\n      \"tail_surface\": \"lo strumento di rimozione della girante Jabsco della dimensione corretta\",\n      \"tail_canonical_zh\": \"正确尺寸的Jabsco拆卸工具\",\n      \"tail_type\": \"Tool\",\n      \"evidence_text\": \"Rimuovere la girante utilizzando lo strumento di rimozione della girante Jabsco della dimensione corretta.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"maintenance\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"Controllare che il coperchio terminale si muova liberamente e, se è bloccato, picchiettare delicatamente lateralmente con un martello morbido, senza fare leva\",\n      \"head_canonical_zh\": \"检查终端盖是否能自由移动，若卡住则轻轻敲打侧面，但不要施加杠杆力\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"inspected_by\",\n      \"tail_surface\": \"Controllare che il coperchio terminale si muove liberamente e, se è bloccato, picchiettare delicatamente lateralmente con un martello morbido, senza fare leva\",\n      \"tail_canonical_zh\": \"检查终端盖是否能自由移动，若卡住则轻轻敲打侧面，但不要施加杠杆力\",\n      \"tail_type\": \"InspectionMethod\",\n      \"evidence_text\": \"Controllare che il coperchio terminale si muove liberamente e, se è bloccato, picchiettare delicatamente lateralmente con un martello morbido, senza fare leva.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    }\n  ],\n  \"warnings\": []\n}",
