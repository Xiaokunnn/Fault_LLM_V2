{
  "content": "{\n  \"triples\": [\n    {\n      \"head_surface\": \"Corrosion monitoring techniques\",\n      \"head_canonical_zh\": \"腐蚀监测技术\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"provides_help\",\n      \"tail_surface\": \"提供早期警告，表明存在可能导致腐蚀引起的失效的损坏条件\",\n      \"tail_canonical_zh\": \"提供早期警告，表明存在可能导致腐蚀引起的失效的损坏条件\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"By providing early warning that damaging conditions exist which may result in a corrosion-induced failure;\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    },\n    {\n      \"head_surface\": \"Corrosion monitoring techniques\",\n      \"head_canonical_zh\": \"腐蚀监测技术\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"provides_help\",\n      \"tail_surface\": \"通过检查工艺参数的变化及其对系统腐蚀性的影响的相关性\",\n      \"tail_canonical_zh\": \"通过检查工艺参数的变化及其对系统腐蚀性的影响的相关性\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"By examining the correlation of changes in process parameters and their effect on system corrosivity;\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    },\n    {\n      \"head_surface\": \"Corrosion monitoring techniques\",\n      \"head_canonical_zh\": \"腐蚀监测技术\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"provides_help\",\n      \"tail_surface\": \"确定特定腐蚀问题的根本原因，并识别控制参数，如压力、温度、pH值、流速等\",\n      \"tail_canonical_zh\": \"确定特定腐蚀问题的根本原因，并识别控制参数，如压力、温度、pH值、流速等\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"By determining the root cause(s) of a particular corrosion problem, and identifying the rate controlling parameters, such as pressure, temperature, pH, flow rate, etc.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    },\n    {\n      \"head_surface\": \"Corrosion monitoring techniques\",\n      \"head_canonical_zh\": \"腐蚀监测技术\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"provides_help\",\n      \"tail_surface\": \"评估系统中腐蚀控制/预防技术的有效性，例如化学抑制和最佳应用的确定\",\n      \"tail_canonical_zh\": \"评估系统中腐蚀控制/预防技术的有效性，例如化学抑制和最佳应用的确定\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"By evaluating the effectiveness of corrosion control/prevention techniques in systems, such as chemical inhibition and the determination of optimal applications.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    },\n    {\n      \"head_surface\": \"Corrosion monitoring techniques\",\n      \"head_canonical_zh\": \"腐蚀监测技术\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"provides_help\",\n      \"tail_surface\": \"向操作员和岸上管理提供关于设备/系统的维护需求和持续状况的信息\",\n      \"tail_canonical_zh\": \"向操作员和岸上管理提供关于设备/系统的维护需求和持续状况的信息\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"By providing the operator and shore side management information relating to the maintenance requirements and ongoing condition of the equipment/system.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    },\n    {\n      \"head_surface\": \"Corrosion monitoring techniques\",\n      \"head_canonical_zh\": \"腐蚀监测技术\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"does_not_waive\",\n      \"tail_surface\": \"ABS规则要求的详细检查\",\n      \"tail_canonical_zh\": \"ABS规则要求的详细检查\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"Corrosion monitoring as described in this Section does not waive any of the close-up surveys required by the ABS Rules.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"operating_condition\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    },\n    {\n      \"head_surface\": \"Coupon testing\",\n      \"head_canonical_zh\": \"试片测试\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"can_be_used_for\",\n      \"tail_surface\": \"过程设施、地下/海底结构、淡水或海水冷却系统、电气发电系统、阴极保护监测、磨蚀性浆液输送和大气腐蚀监测\",\n      \"tail_canonical_zh\": \"过程设施、地下/海底结构、淡水或海水冷却系统、电气发电系统、阴极保护监测、磨蚀性浆液输送和大气腐蚀监测\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"This technique can be used to perform tests at process facilities, underground/undersea structures, fresh water or sea water cooling systems, and electrical generating systems, and for cathodic protection monitoring, abrasive slurry transport, and atmospheric corrosion monitoring.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"operating_condition\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    },\n    {\n      \"head_surface\": \"Coupon testing\",\n      \"head_canonical_zh\": \"试片测试\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"has_advantage\",\n      \"tail_surface\": \"当环境在整个测试期间保持一致时，可以准确预测腐蚀效果\",\n      \"tail_canonical_zh\": \"当环境在整个测试期间保持一致时，可以准确预测腐蚀效果\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"Advantages of this technique include the following: i) Corrosion effects can be accurately predicted when the environment is consistent over the test period.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    },\n    {\n      \"head_surface\": \"Coupon testing\",\n      \"head_canonical_zh\": \"试片测试\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"has_advantage\",\n      \"tail_surface\": \"测试相对便宜且能提供生动的例子来说明预期的腐蚀情况\",\n      \"tail_canonical_zh\": \"测试相对便宜且能提供生动的例子来说明预期的腐蚀情况\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"Advantages of this technique include the following: ii) Testing is relatively inexpensive and yields vivid examples of the corrosion to expect.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    },\n    {\n      \"head_surface\": \"Coupon testing\",\n      \"head_canonical_zh\": \"试片测试\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"has_disadvantage\",\n      \"tail_surface\": \"测试可能需要很长时间才能完成\",\n      \"tail_canonical_zh\": \"测试可能需要很长时间才能完成\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"Disadvantages of this technique include the following: i) Testing can take a long time to complete.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    },\n    {\n      \"head_surface\": \"Coupon testing\",\n      \"head_canonical_zh\": \"试片测试\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"has_disadvantage\",\n      \"tail_surface\": \"确定腐蚀率可能需要几周或几个月的测试\",\n      \"tail_canonical_zh\": \"确定腐蚀率可能需要几周或几个月的测试\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"Disadvantages of this technique include the following: ii) Determining the corrosion rates can take several weeks or months of testing.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    }\n  ],\n  \"warnings\": []\n}",
