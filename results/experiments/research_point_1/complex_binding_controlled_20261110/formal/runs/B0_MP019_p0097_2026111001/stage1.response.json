  "content": "{\n  \"triples\": [\n    {\n      \"head_surface\": \"isolationsresistansen, korrigerad till 25°C, måste överstiga referensvärdet, dvs. 100 MΩ (mätt med 500 eller 1000 V DC)\",\n      \"head_canonical_zh\": \"绝缘电阻值\",\n      \"head_type\": \"Component\",\n      \"relation\": \"specifies\",\n      \"tail_surface\": \"100 MΩ\",\n      \"tail_canonical_zh\": \"100兆欧\",\n      \"tail_type\": \"Standard\",\n      \"evidence_text\": \"isolationsresistansen, korrigerad till 25°C, måste överstiga referensvärdet, dvs. 100 MΩ (mätt med 500 eller 1000 V DC)\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"isolationssystemet kan misstänkas ha blivit fuktigt\",\n      \"head_canonical_zh\": \"绝缘系统可能受潮\",\n      \"head_type\": \"FaultMode\",\n      \"relation\": \"manifests_as\",\n      \"tail_surface\": \"mätta isolationsresistansen\",\n      \"tail_canonical_zh\": \"测量绝缘电阻\",\n      \"tail_type\": \"InspectionMethod\",\n      \"evidence_text\": \"Mät isolationsresistansen före driftsättning och då lindningarna kan misstänkas ha blivit fuktiga.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"motorhöljet måste vara jordat\",\n      \"head_canonical_zh\": \"电机外壳必须接地\",\n      \"head_type\": \"Component\",\n      \"relation\": \"inspected_by\",\n      \"tail_surface\": \"jordning\",\n      \"tail_canonical_zh\": \"接地\",\n      \"tail_type\": \"InspectionAction\",\n      \"evidence_text\": \"Motorhöljet måste vara jordat