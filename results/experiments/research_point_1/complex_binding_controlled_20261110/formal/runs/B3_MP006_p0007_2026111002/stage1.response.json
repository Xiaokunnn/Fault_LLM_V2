  "content": "{\n  \"triples\": [\n    {\n      \"head_surface\": \"ISO 10816-3 Vibration Severity Chart\",\n      \"head_canonical_zh\": \"ISO 10816-3振动严重性图表\",\n      \"head_type\": \"Standard\",\n      \"relation\": \"specifies_by\",\n      \"tail_surface\": \"Pump\",\n      \"tail_canonical_zh\": \"泵\",\n      \"tail_type\": \"Equipment\",\n      \"evidence_text\": \"Pump >7 >10\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"ISO 10816-3 Vibration Severity Chart\",\n      \"head_canonical_zh\": \"ISO 10816-3振动严重性图表\",\n      \"head_type\": \"Standard\",\n      \"relation\": \"specifies_by\",\n      \"tail_surface\": \"Motor (drive end)\",\n      \"tail_canonical_zh\": \"驱动端电机\",\n      \"tail_type\": \"Equipment\",\n      \"evidence_text\": \"Motor (drive end) >7 >10\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"ISO 10816-3 Vibration Severity Chart\",\n      \"head_canonical_zh\": \"ISO 10816-3振动严重性图表\",\n      \"head_type\": \"Standard\",\n      \"relation\": \"specifies_by\",\n      \"tail_surface\": \"Motor (non drive end)\",\n      \"tail_canonical_zh\": \"非驱动端电机\",\n      \"tail_type\": \"Equipment\",\n      \"evidence_text\": \"Motor (non drive end) >10 >15\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"vibration levels\",\n      \"head_canonical_zh\": \"振动水平\",\n      \"head_type\": \"Symptom\",\n      \"relation\": \"manifests_as\",\n      \"tail_surface\": \"shorter lifetimes of e.g. bearings and/or shaft seals in pumps (and bearings in motors)\",\n      \"tail_canonical_zh\": \"泵（和电机中的轴承）的寿命缩短\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"vibration levels above 7 mm/s are damaging – i.e. this will result in shorter lifetimes of e.g. bearings and/or shaft seals in pumps (and bearings in motors) than normally expected.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"vibration levels\",\n      \"head_canonical_zh\": \"振动水平\",\n      \"head_type\": \"Symptom\",\n      \"relation\": \"manifests_as\",\n      \"tail_surface\": \"vibration velocities than 7 mm/s\",\n      \"tail_canonical_zh\": \"大于7 mm/s的振动速度\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"But in pump installations on ships external excited vibrations from main engine and/or auxiliary machinery are transferred from ship hull to the pump often resulting in much higher vibration velocities than 7 mm/s.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"vibration alarm level\",\n      \"head_canonical_zh\": \"振动报警级别\",\n      \"head_type\": \"Symptom\",\n      \"relation\": \"manifests_as\",\n      \"tail_surface\": \"vibration trip level\",\n      \"tail_canonical_zh\": \"振动跳闸级别\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"Pump >7 >10\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    }\n  ],\n  \"warnings\": []\n}",
