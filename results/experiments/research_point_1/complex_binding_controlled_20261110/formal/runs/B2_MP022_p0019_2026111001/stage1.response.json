  "content": "{\n  \"triples\": [\n    {\n      \"head_surface\": \"Check the direction of rotation of the impeller before operation.\",\n      \"head_canonical_zh\": \"检查叶轮旋转方向\",\n      \"head_type\": \"InspectionAction\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"Installation\",\n      \"tail_canonical_zh\": \"安装\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"Check the direction of rotation of the impeller before operation. - See the indication label on the pump.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"Packing material consists of wood, plastics, cardboard boxes and, in some cases, metal straps\",\n      \"head_canonical_zh\": \"包装材料包括木材、塑料、纸板箱以及某些情况下金属带\",\n      \"head_type\": \"Standard\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"Recycling information\",\n      \"tail_canonical_zh\": \"回收信息\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"Packing material consists of wood, plastics, cardboard boxes and, in some cases, metal straps - Wood and cardboard boxes can be re-used, recycled or used for energy recovery - Plastics should be recycled or burnt at a licensed waste incineration plant - Metal straps should be sent for material recycling\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"Wood and cardboard boxes can be re-used, recycled or used for energy recovery\",\n      \"head_canonical_zh\": \"木材和纸板箱可以重复使用、回收或用于能源回收\",\n      \"head_type\": \"Standard\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"Recycling information\",\n      \"tail_canonical_zh\": \"回收信息\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"Packing material consists of wood, plastics, cardboard boxes and, in some cases, metal straps - Wood and cardboard boxes can be re-used, recycled or used for energy recovery - Plastics should be recycled or burnt at a licensed waste incineration plant - Metal straps should be sent for material recycling\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"Plastics should be recycled or burnt at a licensed waste incineration plant\",\n      \"head_canonical_zh\": \"塑料应进行回收或在许可的废物焚烧厂焚烧\",\n      \"head_type\": \"Standard\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"Recycling information\",\n      \"tail_canonical_zh\": \"回收信息\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"Packing material consists of wood, plastics, cardboard boxes and, in some cases, metal straps - Wood and cardboard boxes can be re-used, recycled or used for energy recovery - Plastics should be recycled or burnt at a licensed waste incineration plant - Metal straps should be sent for material recycling\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"Metal straps should be sent for material recycling\",\n      \"head_canonical_zh\": \"金属带应送至材料回收处\",\n      \"head_type\": \"Standard\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"Recycling information\",\n      \"tail_canonical_zh\": \"回收信息\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"Packing material consists of wood, plastics, cardboard boxes and, in some cases, metal straps - Wood and cardboard boxes can be re-used, recycled or used for energy recovery - Plastics should be recycled or burnt at a licensed waste incineration plant - Metal straps should be sent for material recycling\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"During maintenance, oil and wearing parts in the machine are replaced\",\n      \"head_canonical_zh\": \"在维护期间，更换机器中的油和磨损部件\",\n      \"head_type\": \"MaintenanceAction\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"Maintenance\",\n      \"tail_canonical_zh\": \"维护\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"M\\u00c3\\u00a4intenance - During maintenance, oil and wearing parts in the machine are replaced - All metal parts should be sent for material recycling - Worn or defective electronic parts should be sent to a licensed handler for material recycling - Oil and all non-metal wearing parts must be disposed of in accordance with local regulations\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"maintenance\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"All metal parts should be sent for material recycling\",\n      \"head_canonical_zh\": \"所有金属部件应送至材料回收处\",\n      \"head_type\": \"MaintenanceAction\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"Maintenance\",\n      \"tail_canonical_zh\": \"维护\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"M\\u00c3\\u00a4intenance - During maintenance, oil and wearing parts in the machine are replaced - All metal parts should be sent for material recycling - Worn or defective electronic parts should be sent to a licensed handler for material recycling - Oil and all non-metal wearing parts must be disposed of in accordance with local regulations\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"maintenance\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"Worn or defective electronic parts should be sent to a licensed handler for material recycling\",\n      \"head_canonical_zh\": \"磨损或损坏的电子部件应送至授权处理商进行材料回收\",\n      \"head_type\": \"MaintenanceAction\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"Maintenance\",\n      \"tail_canonical_zh\": \"维护\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"M\\u00c3\\u00a4intenance - During maintenance, oil and wearing parts in the machine are replaced - All metal parts should be sent for material recycling - Worn or defective electronic parts should be sent to a licensed handler for material recycling - Oil and all non-metal wearing parts must be disposed of in accordance with local regulations\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"maintenance\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"Oil and all non-metal wearing parts must be disposed of in accordance with local regulations\",\n      \"head_canonical_zh\": \"油和所有非金属磨损部件必须按照当地规定处置\",\n      \"head_type\": \"MaintenanceAction\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"Maintenance\",\n      \"tail_canonical_zh\": \"维护\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"M\\u00c3\\u00a4intenance - During maintenance, oil and wearing parts in the machine are replaced - All metal parts should be sent for material recycling - Worn or defective electronic parts should be sent to a licensed handler for material recycling - Oil and all non-metal wearing parts must be disposed of in accordance with local regulations\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"maintenance\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"At the end of use, the equipment must be recycled according to relevant local regulations\",\n      \"head_canonical_zh\": \"使用结束后，设备必须根据相关当地规定进行回收\",\n      \"head_type\": \"Standard\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"Scrap\",\n      \"tail_canonical_zh\": \"报废\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"S\\u00c3\\u00a4craaapppppiinnngg - At the end of use, the equipment must be recycled according to relevant local regulations. In addition to the equipment itself, any hazardous residue from the process liquid must be taken into account and handled in the necessary way. When in doubt, or in the absence of local regulations, please contact your local Alfa Laval sales company.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"Any hazardous residue from the process liquid must be taken into account and handled in the necessary way\",\n      \"head_canonical_zh\": \"任何来自工艺液体的有害残留物必须予以考虑并适当处理\",\n      \"head_type\": \"Standard\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"Scrap\",\n      \"tail_canonical_zh\": \"报废\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"S\\u00c3\\u00a4craaapppppiinnngg - At the end of use, the equipment must be recycled according to relevant local regulations. In addition to the equipment itself, any hazardous residue from the process liquid must be taken into account and handled in the necessary way. When in doubt, or in the absence of local regulations, please contact your local Alfa Laval sales company.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"When in doubt, or in the absence of local regulations, please contact your local Alfa Laval sales company\",\n      \"head_canonical_zh\": \"如有疑问或缺乏当地规定，请联系当地阿尔法拉瓦尔销售公司\",\n      \"head_type\": \"Standard\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"Scrap\",\n      \"tail_canonical_zh\": \"报废\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"S\\u00c3\\u00a4craaapppppiinnngg - At the end of use, the equipment must be recycled according to relevant local regulations. In addition to the equipment itself, any hazardous residue from the process liquid must be taken into account and handled in the necessary way. When in doubt, or in the absence of local regulations, please contact your local Alfa Laval sales company.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    }\n  ],\n  \"warnings\": []\n}",
