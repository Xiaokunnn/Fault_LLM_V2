{
  "content": "{\n  \"triples\": [\n    {\n      \"head_surface\": \"旋转部件\",\n      \"head_canonical_zh\": \"旋转部件\",\n      \"head_type\": \"Component\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"泵\",\n      \"tail_canonical_zh\": \"泵\",\n      \"tail_type\": \"Equipment\",\n      \"evidence_text\": \"exposed rotating parts can catch clothing, fingers, or tools, causing severe injury to personnel.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"电气连接\",\n      \"head_canonical_zh\": \"电气连接\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"inspected_by\",\n      \"tail_surface\": \"合格电工\",\n      \"tail_canonical_zh\": \"合格电工\",\n      \"tail_type\": \"InspectionAction\",\n      \"evidence_text\": \"obtain the services of a qualified electrician to make all electrical connections.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"旋转方向错误\",\n      \"head_canonical_zh\": \"旋转方向错误\",\n      \"head_type\": \"FaultMode\",\n      \"relation\": \"causes\",\n      \"tail_surface\": \"泵损坏\",\n      \"tail_canonical_zh\": \"泵损坏\",\n      \"tail_type\": \"FailureMechanism\",\n      \"evidence_text\": \"If rotation is incorrect on a three-phase motor, have a qualified electrician interchange any two of the three phase wires to change direction.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"cause_or_mechanism\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"电气连接\",\n      \"head_canonical_zh\": \"电气连接\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"inspected_by\",\n      \"tail_surface\": \"合格电工\",\n      \"tail_canonical_zh\": \"合格电工\",\n      \"tail_type\": \"InspectionAction\",\n      \"evidence_text\": \"check that the motor speed meets pump specifications.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"电气连接\",\n      \"head_canonical_zh\": \"电气连接\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"inspected_by\",\n      \"tail_surface\": \"合格电工\",\n      \"tail_canonical_zh\": \"合格电工\",\n      \"tail_type\": \"InspectionAction\",\n      \"evidence_text\": \"check that the electrical service available matches the motor requirements stamped on the motor name-plate before connecting a motor to the incoming power.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"电击\",\n      \"head_canonical_zh\": \"电击\",\n      \"head_type\": \"Risk\",\n      \"relation\": \"increases_risk_of\",\n      \"tail_surface\": \"操作泵\",\n      \"tail_canonical_zh\": \"操作泵\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"The electrical power used to operate the pump is high enough to cause injury or death.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"risk\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"电气连接\",\n      \"head_canonical_zh\": \"电气连接\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"inspected_by\",\n      \"tail_surface\": \"合格电工\",\n      \"tail_canonical_zh\": \"合格电工\",\n      \"tail_type\": \"InspectionAction\",\n      \"evidence_text\": \"Do not operate the pump without the guard in place over the rotating parts.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    }\n  ],\n  \"warnings\": []\n}",
