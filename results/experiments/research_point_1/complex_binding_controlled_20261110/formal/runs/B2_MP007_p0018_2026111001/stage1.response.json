ence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"The O-ring of the diffuser is damaged\",\n      \"head_canonical_zh\": \"扩散器O形圈损坏\",\n      \"head_type\": \"Symptom\",\n      \"relation\": \"manifests_as\",\n      \"tail_surface\": \"Replace the O-ring\",\n      \"tail_canonical_zh\": \"更换O形圈\",\n      \"tail_type\": \"MaintenanceAction\",\n      \"evidence_text\": \"The O-ring of the diffuser is damaged Replace the O-ring\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"The O-ring is not suitable for the pumping medium\",\n      \"head_canonical_zh\": \"O形圈不适合泵送介质\",\n      \"head_type\": \"Symptom\",\n      \"relation\": \"manifests_as\",\n      \"tail_surface\": \"Replace with an O-ring suitable for the pumping medium.\",\n      \"tail_canonical_zh\": \"更换适合泵送介质的O形圈\",\n      \"tail_type\": \"MaintenanceAction\",\n      \"evidence_text\": \"The O-ring is not suitable for the pumping medium Replace with an O-ring suitable for the pumping medium.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    }\n  ],\n  \"warnings\": []\n}",
