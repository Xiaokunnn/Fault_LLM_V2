  "content": "{\n  \"triples\": [\n    {\n      \"head_surface\": \"The pump interior is blocked\",\n      \"head_canonical_zh\": \"泵内部堵塞\",\n      \"head_type\": \"Symptom\",\n      \"relation\": \"manifests_as\",\n      \"tail_surface\": \"Check the pump interior\",\n      \"tail_canonical_zh\": \"检查泵内部\",\n      \"tail_type\": \"InspectionAction\",\n      \"evidence_text\": \"The pump interior is blocked Check the pump interior\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"The heat protection switch of the motor is triggered\",\n      \"head_canonical_zh\": \"电机过热保护开关触发\",\n      \"head_type\": \"Symptom\",\n      \"relation\": \"manifests_as\",\n      \"tail_surface\": \"The heat protection switch of the motor. If this problem often occurs, please contact the supplier.\",\n      \"tail_canonical_zh\": \"电机过热保护开关。如果此问题经常发生，请联系供应商。\",\n      \"tail_type\": \"MaintenanceAction\",\n      \"evidence_text\": \"The heat protection switch of the motor is triggered The heat protection switch of the motor. If this problem often occurs, please contact the supplier.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"The pump shaft is damaged\",\n      \"head_canonical_zh\": \"泵轴损坏\",\n      \"head_type\": \"Symptom\",\n      \"relation\": \"manifests_as\",\n      \"tail_surface\": \"Contact the manufacturer to replace it\",\n      \"tail_canonical_zh\": \"联系制造商更换\",\n      \"tail_type\": \"MaintenanceAction\",\n      \"evidence_text\": \"The pump shaft is damaged Contact the manufacturer to replace it\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"There is air in the pump\",\n      \"head_canonical_zh\": \"泵内有空气\",\n      \"head_type\": \"Symptom\",\n      \"relation\": \"manifests_as\",\n      \"tail_surface\": \"Discharge air in the pump\",\n      \"tail_canonical_zh\": \"排出泵内的空气\",\n      \"tail_type\": \"MaintenanceAction\",\n      \"evidence_text\": \"There is air in the pump Discharge air in the pump\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"The pump rotating direction is wrong\",\n      \"head_canonical_zh\": \"泵旋转方向错误\",\n      \"head_type\": \"Symptom\",\n      \"relation\": \"manifests_as\",\n      \"tail_surface\": \"Replace two phases of three-phase wiring\",\n      \"tail_canonical_zh\": \"更换三相电线中的两相\",\n      \"tail_type\": \"MaintenanceAction\",\n      \"evidence_text\": \"The pump rotating direction is wrong Replace two phases of three-phase wiring\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"There is no air discharge in the suction pipe\",\n      \"head_canonical_zh\": \"吸水管内无空气排出\",\n      \"head_type\": \"Symptom\",\n      \"relation\": \"manifests_as\",\n      \"tail_surface\": \"Discharge air in the suction pipe.\",\n      \"tail_canonical_zh\": \"排出吸水管内的空气\",\n      \"tail_type\": \"MaintenanceAction\",\n      \"evidence_text\": \"There is no air discharge in the suction pipe Discharge air in the suction pipe.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"There is air leakage at the suction end\",\n      \"head_canonical_zh\": \"吸入口处有空气泄漏\",\n      \"head_type\": \"Symptom\",\n      \"relation\": \"manifests_as\",\n      \"tail_surface\": \"Check the air leakage position.\",\n      \"tail_canonical_zh\": \"检查空气泄漏位置\",\n      \"tail_type\": \"InspectionAction\",\n      \"evidence_text\": \"There is air leakage at the suction end Check the air leakage position.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"Water flow is very low, the bubble pump is blocked\",\n      \"head_canonical_zh\": \"水流很低，气泡泵堵塞\",\n      \"head_type\": \"Symptom\",\n      \"relation\": \"manifests_as\",\n      \"tail_surface\": \"Make sure that flow is increased or a smaller pump is used\",\n      \"tail_canonical_zh\": \"确保增加流量或使用较小的泵\",\n      \"tail_type\": \"MaintenanceAction\",\n      \"evidence_text\": \"Water flow is very low, the bubble pump is blocked Make sure that flow is increased or a smaller pump is used\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 