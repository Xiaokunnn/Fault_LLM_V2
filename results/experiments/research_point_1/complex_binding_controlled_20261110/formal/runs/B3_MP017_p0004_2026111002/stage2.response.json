{
  "content": "{\n  \"triples\": [\n    {\n      \"head_surface\": \"Check the temperature before opening any covers, plates, or plugs.\",\n      \"head_canonical_zh\": \"检查温度再打开任何盖板、板或插口\",\n      \"head_type\": \"InspectionAction\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"SELF-PRIMING CENTRIFUGAL PUMPS\",\n      \"tail_canonical_zh\": \"自吸离心泵\",\n      \"tail_type\": \"Equipment\",\n      \"evidence_text\": \"Check the temperature before opening any covers, plates, or plugs.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Close the suction and discharge valves.\",\n      \"head_canonical_zh\": \"关闭吸入和排出阀\",\n      \"head_type\": \"MaintenanceAction\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"SELF-PRIMING CENTRIFUGAL PUMPS\",\n      \"tail_canonical_zh\": \"自吸离心泵\",\n      \"tail_type\": \"Equipment\",\n      \"evidence_text\": \"Close the suction and discharge valves.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"maintenance\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Vent the pump slowly and cautiously.\",\n      \"head_canonical_zh\": \"缓慢谨慎地排气\",\n      \"head_type\": \"InspectionAction\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"SELF-PRIMING CENTRIFUGAL PUMPS\",\n      \"tail_canonical_zh\": \"自吸离心泵\",\n      \"tail_type\": \"Equipment\",\n      \"evidence_text\": \"Vent the pump slowly and cautiously.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Drain the pump.\",\n      \"head_canonical_zh\": \"排空泵\",\n      \"head_type\": \"MaintenanceAction\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"SELF-PRIMING CENTRIFUGAL PUMPS\",\n      \"tail_canonical_zh\": \"自吸离心泵\",\n      \"tail_type\": \"Equipment\",\n      \"evidence_text\": \"Drain the pump.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"maintenance\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Do not attempt to pump any liquids the pump has not been designed for.\",\n      \"head_canonical_zh\": \"不要尝试泵送泵未设计的液体\",\n      \"head_type\": \"Risk\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"SELF-PRIMING CENTRIFUGAL PUMPS\",\n      \"tail_canonical_zh\": \"自吸离心泵\",\n      \"tail_type\": \"Equipment\",\n      \"evidence_text\": \"Do not attempt to pump any liquids the pump has not been designed for, and which may damage the pump or endanger personnel as a result of pump failure.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"risk\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Consult the factory to determine compatibility between the pump and liquid.\",\n      \"head_canonical_zh\": \"咨询厂家以确定泵与液体的兼容性\",\n      \"head_type\": \"InspectionAction\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"SELF-PRIMING CENTRIFUGAL PUMPS\",\n      \"tail_canonical_zh\": \"自吸离心泵\",\n      \"tail_type\": \"Equipment\",\n      \"evidence_text\": \"Consult the factory to determine compatibility between the pump and liquid.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Use lifting and moving equipment in good repair and with adequate capacity.\",\n      \"head_canonical_zh\": \"使用良好修复并具有足够容量的起吊和移动设备\",\n      \"head_type\": \"InspectionAction\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"SELF-PRIMING CENTRIFUGAL PUMPS\",\n      \"tail_canonical_zh\": \"自吸离心泵\",\n      \"tail_type\": \"Equipment\",\n      \"evidence_text\": \"Use lifting and moving equipment in good repair and with adequate capacity to prevent injuries to personnel or damage to equipment.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Make certain that the pump and all piping or hose connections are tight, properly supported and secure before operation.\",\n      \"head_canonical_zh\": \"确保泵及其所有管道或软管连接在操作前紧固、支撑良好且牢固\",\n      \"head_type\": \"InspectionAction\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"SELF-PRIMING CENTRIFUGAL PUMPS\",\n      \"tail_canonical_zh\": \"自吸离心泵\",\n      \"tail_type\": \"Equipment\",\n      \"evidence_text\": \"Make certain that the pump and all piping or hose connections are tight, properly supported and secure before operation.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    }\n  ],\n  \"warnings\": []\n}",
