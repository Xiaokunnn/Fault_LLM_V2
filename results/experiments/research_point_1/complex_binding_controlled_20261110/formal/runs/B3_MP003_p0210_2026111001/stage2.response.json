{
  "content": "{\n  \"triples\": [\n    {\n      \"head_surface\": \"Gear cases are to be of substantial construction in order to minimize elastic deflections and maintain accurate mounting of the gears.\",\n      \"head_canonical_zh\": \"齿轮箱应具有足够的结构强度以最小化弹性变形并保持齿轮的精确安装\",\n      \"head_type\": \"Equipment\",\n      \"relation\": \"specifies_by\",\n      \"tail_surface\": \"Calculations, in accordance with the manufacturer's code of practice, substantiating these Rule requirements are to be submitted.\",\n      \"tail_canonical_zh\": \"提交根据制造商的工艺规范进行计算，以证明这些规定的要求\",\n      \"tail_type\": \"Standard\",\n      \"evidence_text\": \"Calculations, in accordance with the manufacturer's code of practice, substantiating these Rule requirements are to be submitted.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"For gear case designs for which the manufacturer can provide a satisfactory service history, submission of calculations may be waived.\",\n      \"head_canonical_zh\": \"对于制造商能够提供满意的服务历史的齿轮箱设计，可以免除提交计算\",\n      \"head_type\": \"Equipment\",\n      \"relation\": \"specifies_by\",\n      \"tail_surface\": \"Calculations, in accordance with the manufacturer's code of practice, substantiating these Rule requirements are to be submitted.\",\n      \"tail_canonical_zh\": \"提交根据制造商的工艺规范进行计算，以证明这些规定的要求\",\n      \"tail_type\": \"Standard\",\n      \"evidence_text\": \"Calculations, in accordance with the manufacturer's code of practice, substantiating these Rule requirements are to be submitted.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"The construction of gear cases is to be such that sufficient number of access is provided for adequate inspection of gears, checking of gear teeth contacts and measurement of thrust bearing clearance.\",\n      \"head_canonical_zh\": \"齿轮箱的构造应提供足够的通道以便充分检查齿轮、齿轮啮合情况以及测量推力轴承间隙\",\n      \"head_type\": \"Equipment\",\n      \"relation\": \"specifies_by\",\n      \"tail_surface\": \"The construction of gear cases is to be such that sufficient number of access is provided for adequate inspection of gears, checking of gear teeth contacts and measurement of thrust bearing clearance.\",\n      \"tail_canonical_zh\": \"齿轮箱的构造应提供足够的通道以便充分检查齿轮、齿轮啮合情况以及测量推力轴承间隙\",\n      \"tail_type\": \"Standard\",\n      \"evidence_text\": \"The construction of gear cases is to be such that sufficient number of access is provided for adequate inspection of gears, checking of gear teeth contacts and measurement of thrust bearing clearance.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"The diameter of shafts for gears is to be determined by the following equations:\",\n      \"head_canonical_zh\": \"齿轮轴的直径应由以下方程确定\",\n      \"head_type\": \"Equipment\",\n      \"relation\": \"specifies_by\",\n      \"tail_surface\": \"d = k. bT + mM\",\n      \"tail_canonical_zh\": \"d = k. bT + mM\",\n      \"tail_type\": \"Standard\",\n      \"evidence_text\": \"d = k. bT + mM\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    }\n  ],\n  \"warnings\": []\n}",
