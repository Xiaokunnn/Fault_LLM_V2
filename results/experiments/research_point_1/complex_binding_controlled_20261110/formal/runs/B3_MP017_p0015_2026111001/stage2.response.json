{
  "content": "{\n  \"triples\": [\n    {\n      \"head_surface\": \"exposed rotating parts\",\n      \"head_canonical_zh\": \"暴露的旋转部件\",\n      \"head_type\": \"Component\",\n      \"relation\": \"causes\",\n      \"tail_surface\": \"severe injury to personnel\",\n      \"tail_canonical_zh\": \"严重的人身伤害\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"exposed rotating parts can catch clothing, fingers, or tools, causing severe injury to personnel.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"non-explosion proof motor\",\n      \"head_canonical_zh\": \"非防爆电机\",\n      \"head_type\": \"Component\",\n      \"relation\": \"causes\",\n      \"tail_surface\": \"explosion\",\n      \"tail_canonical_zh\": \"爆炸\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"do not operate a non-explosion proof motor in an explosive atmosphere. An explosion, which may cause severe personal injury or death, could result.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"incorrect rotation on a three-phase motor\",\n      \"head_canonical_zh\": \"三相电机旋转方向错误\",\n      \"head_type\": \"OperatingCondition\",\n      \"relation\": \"causes\",\n      \"tail_surface\": \"damage both pump and power source\",\n      \"tail_canonical_zh\": \"损坏泵和动力源\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"overspeeding the pump may damage both pump and power source.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"incorrect rotation on a single-phase motor\",\n      \"head_canonical_zh\": \"单相电机旋转方向错误\",\n      \"head_type\": \"OperatingCondition\",\n      \"relation\": \"causes\",\n      \"tail_surface\": \"damage to the motor\",\n      \"tail_canonical_zh\": \"电机损坏\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"consult the literature supplied with the motor for specific instructions.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"guard in place over the rotating parts\",\n      \"head_canonical_zh\": \"旋转部件上的防护罩\",\n      \"head_type\": \"Component\",\n      \"relation\": \"prevented_by\",\n      \"tail_surface\": \"exposed rotating parts\",\n      \"tail_canonical_zh\": \"暴露的旋转部件\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"Do not operate the pump without the guard in place over the rotating parts.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"prevention\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"qualified electrician\",\n      \"head_canonical_zh\": \"合格电工\",\n      \"head_type\": \"Component\",\n      \"relation\": \"inspected_by\",\n      \"tail_surface\": \"electrical connections\",\n      \"tail_canonical_zh\": \"电气连接\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"obtain the services of a qualified electrician to make all electrical connections.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"National Electric Code\",\n      \"head_canonical_zh\": \"国家电气规范\",\n      \"head_type\": \"Standard\",\n      \"relation\": \"specifies\",\n      \"tail_surface\": \"installation and operation of the pump\",\n      \"tail_canonical_zh\": \"泵的安装和操作\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"install, connect and operate the motor in accordance with the National Electric Code and all local codes.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    }\n  ],\n  \"warnings\": []\n}",
