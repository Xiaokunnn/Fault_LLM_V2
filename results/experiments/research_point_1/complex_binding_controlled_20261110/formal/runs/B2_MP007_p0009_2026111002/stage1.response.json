{
  "content": "{\n  \"triples\": [\n    {\n      \"head_surface\": \"If all flow passage components required by the system are made of high-grade stainless steel, a special material is needed.\",\n      \"head_canonical_zh\": \"如果系统所需的全部流道组件都是高级不锈钢制成，则需要特殊材料\",\n      \"head_type\": \"Component\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"system\",\n      \"tail_canonical_zh\": \"系统\",\n      \"tail_type\": \"Equipment\",\n      \"evidence_text\": \"If all flow passage components required by the system are made of high-grade stainless steel, a special material is needed.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"structural_context\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"The product runs in the environment with a max temperature of +40°C.\",\n      \"head_canonical_zh\": \"产品在环境温度最高为+40°C的情况下运行\",\n      \"head_type\": \"OperatingCondition\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"environment\",\n      \"tail_canonical_zh\": \"环境\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"The product runs in the environment with a max temperature of +40°C.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"operating_condition\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"In case that ambient temperature exceeds +40°C or the motor is installed above 1,000m altitude, the motor rated output power (P2) will decrease due to the poor motor cooling effect caused by low air density, as shown in Chart 1.\",\n      \"head_canonical_zh\": \"如果环境温度超过+40°C或者电机安装在海拔1000米以上的位置，由于空气密度低导致的散热效果差，电机额定输出功率（P2）将降低，如图表1所示\",\n      \"head_type\": \"OperatingCondition\",\n      \"relation\": \"causes\",\n      \"tail_surface\": \"motor rated output power (P2) will decrease\",\n      \"tail_canonical_zh\": \"电机额定输出功率（P2）将降低\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"In case that ambient temperature exceeds +40°C or the motor is installed above 1,000m altitude, the motor rated output power (P2) will decrease due to the poor motor cooling effect caused by low air density, as shown in Chart 1.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"cause_or_mechanism\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"a motor with higher output power shall be used.\",\n      \"head_canonical_zh\": \"应使用额定输出功率更高的电机\",\n      \"head_type\": \"MaintenanceAction\",\n      \"relation\": \"specifies\",\n      \"tail_surface\": \"motor with higher output power\",\n      \"tail_canonical_zh\": \"额定输出功率更高的电机\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"a motor with higher output power shall be used.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"maintenance\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"The product runs in the environment with a max temperature of +40°C.\",\n      \"head_canonical_zh\": \"产品在环境温度最高为+40°C的情况下运行\",\n      \"head_type\": \"OperatingCondition\",\n      \"relation\": \"located_in\",\n      \"tail_surface\": \"environment\",\n      \"tail_canonical_zh\": \"环境\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"The product runs in the environment with a max temperature of +40°C.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"operating_condition\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"the motor rated output power (P2) will decrease due to the poor motor cooling effect caused by low air density, as shown in Chart 1.\",\n      \"head_canonical_zh\": \"由于空气密度低导致的散热效果差，电机额定输出功率（P2）将降低，如图表1所示\",\n      \"head_type\": \"Symptom\",\n      \"relation\": \"manifests_as\",\n      \"tail_surface\": \"motor rated output power (P2) will decrease\",\n      \"tail_canonical_zh\": \"电机额定输出功率（P2）将降低\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"the motor rated output power (P2) will decrease due to the poor motor cooling effect caused by low air density, as shown in Chart 1.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"the motor rated output power (P2) will decrease due to the poor motor cooling effect caused by low air density, as shown in Chart 1.\",\n      \"head_canonical_zh\": \"由于空气密度低导致的散热效果差，电机额定输出功率（P2）将降低，如图表1所示\",\n      \"head_type\": \"OperatingCondition\",\n      \"relation\": \"causes\",\n      \"tail_surface\": \"motor rated output power (P2) will decrease\",\n      \"tail_canonical_zh\": \"电机额定输出功率（P2）将降低\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"the motor rated output power (P2) will decrease due to the poor motor cooling effect caused by low air density, as shown in Chart 1.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"cause_or_mechanism\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"a motor with higher output power shall be used.\",\n      \"head_canonical_zh\": \"应使用额定输出功率更高的电机\",\n      \"head_type\": \"MaintenanceAction\",\n      \"relation\": \"mitigates\",\n      \"tail_surface\": \"motor rated output power (P2) will decrease\",\n      \"tail_canonical_zh\": \"电机额定输出功率（P2）将降低\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"a motor with higher output power shall be used.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"maintenance\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"The following chart shows the relationship between liquid temperature and maximum allowable working pressure.\",\n      \"head_canonical_zh\": \"下图显示了液体温度与最大允许工作压力之间的关系\",\n      \"head_type\": \"Standard\",\n      \"relation\": \"specifies\",\n      \"tail_surface\": \"relationship between liquid temperature and maximum allowable working pressure\",\n      \"tail_canonical_zh\": \"液体温度与最大允许工作压力之间的关系\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"The following chart shows the relationship between liquid temperature and maximum allowable working pressure.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Minimum inlet pressure “H” (unit: meter water column) is calculated as below: H=Pb x 10.2 - NPSH - Hf - Hv - Hs\",\n      \"head_canonical_zh\": \"最小入口压力“H”（单位：水柱米）计算如下：H=Pb x 10.2 - NPSH - Hf - Hv - Hs\",\n      \"head_type\": \"Standard\",\n      \"relation\": \"specifies\",\n      \"tail_surface\": \"calculation method for minimum inlet pressure\",\n      \"tail_canonical_zh\": \"最小入口压力的计算方法\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"Minimum inlet pressure “H” (unit: meter water column) is calculated as below: H=Pb x 10.2 - NPSH - Hf - Hv - Hs\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"If the result of calculated H is positive, it means the suction height at the suction side equals to “H”m.\",\n      \"head_canonical_zh\": \"如果计算出的H值为正数，则意味着吸入口的高度等于“H”米\",\n      \"head_type\": \"Symptom\",\n      \"relation\": \"manifests_as\",\n      \"tail_surface\": \"suction height at the suction side equals to “H”m\",\n      \"tail_canonical_zh\": \"吸入口的高度等于“H”米\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"If the result of calculated H is positive, it means the suction height at the suction side equals to “H”m.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"If the result is negative, at least positive Hm pressure is required at the inlet to avoid\",\n      \"head_canonical_zh\": \"如果结果为负数，则至少需要在入口处提供正的Hm压力以避免\",\n      \"head_type\": \"Symptom\",\n      \"relation\": \"manifests_as\",\n      \"tail_surface\": \"at least positive Hm pressure is required at the inlet\",\n      \"tail_canonical_zh\": \"至少需要在入口处提供正的Hm压力\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"If the result is negative, at least positive Hm pressure is required at the inlet to avoid\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    }\n  ],\n  \"warnings\": []\n}",
