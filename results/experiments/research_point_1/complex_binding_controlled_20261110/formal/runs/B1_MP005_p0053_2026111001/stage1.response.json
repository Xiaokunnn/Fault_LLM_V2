{
  "content": "{\n  \"triples\": [\n    {\n      \"head_surface\": \"Do not operate the pump with the shut-off elements in the suction line and/or discharge line closed.\",\n      \"head_canonical_zh\": \"不要关闭吸入管线和/或排出管线的切断元件启动泵\",\n      \"head_type\": \"OperatingCondition\",\n      \"relation\": \"causes\",\n      \"tail_surface\": \"incorrect pressure and temperature\",\n      \"tail_canonical_zh\": \"不正确的压力和温度\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"Do not operate the pump with the shut-off elements in the suction line and/or discharge line closed. Only start up the pump set with the discharge-side shut-off element slightly or fully open.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [\"OPERATING_CONDITION\"],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Do not operate the pump set without liquid fill.\",\n      \"head_canonical_zh\": \"不要在没有液体填充的情况下操作泵组\",\n      \"head_type\": \"OperatingCondition\",\n      \"relation\": \"causes\",\n      \"tail_surface\": \"high temperature due to dry running or too much gas content in the fluid handled\",\n      \"tail_canonical_zh\": \"由于干运转或处理流体中气体含量过高导致的高温\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"Do not operate the pump set without liquid fill. Prime the pump according to operating instructions.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [\"OPERATING_CONDITION\"],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Abnormal noises, vibrations, temperatures or leakage could cause damage to the pump.\",\n      \"head_canonical_zh\": \"异常噪音、振动、温度或泄漏可能导致泵损坏\",\n      \"head_type\": \"Symptom\",\n      \"relation\": \"indicates\",\n      \"tail_surface\": \"damage to the pump\",\n      \"tail_canonical_zh\": \"泵损坏\",\n      \"tail_type\": \"FaultMode\",\n      \"evidence_text\": \"Abnormal noises, vibrations, temperatures or leakage could cause damage to the pump. Stop the pump (set) immediately. Eliminate the causes before returning the pump set to service.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [\"FAULT_MODE\"],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Do not operate the pump with the shut-off elements in the suction line and/or discharge line closed.\",\n      \"head_canonical_zh\": \"不要关闭吸入管线和/或排出管线的切断元件启动泵\",\n      \"head_type\": \"OperatingCondition\",\n      \"relation\": \"causes\",\n      \"tail_surface\": \"explosion hazard\",\n      \"tail_canonical_zh\": \"爆炸危险\",\n      \"tail_type\": \"Risk\",\n      \"evidence_text\": \"DANGER\\nEXPLOSION HAZARD!\\nLEAKAGE OF HOT OR TOXIC FLUIDS!\\nIf the pump is operated with the suction and/or discharge line closed will cause incorrect\\npressure and temperature. Hot or hazard fluids under pressure will cause death or\\nserious injury.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"risk\",\n      \"fault_class_ids\": [\"RISK\"],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Do not operate the pump set without liquid fill.\",\n      \"head_canonical_zh\": \"不要在没有液体填充的情况下操作泵组\",\n      \"head_type\": \"OperatingCondition\",\n      \"relation\": \"causes\",\n      \"tail_surface\": \"explosion hazard\",\n      \"tail_canonical_zh\": \"爆炸危险\",\n      \"tail_type\": \"Risk\",\n      \"evidence_text\": \"DANGER\\nEXPLOSION HAZARD!\\nDAMAGE TO THE PUMP SET!\\nHigh temperature due to dry running or too much gas content in the fluid handled will\\ncause death or serious injury.\\nDo not operate the pump set without liquid fill.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"risk\",\n      \"fault_class_ids\": [\"RISK\"],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Prime the pump according to operating instructions.\",\n      \"head_canonical_zh\": \"根据操作说明进行泵的预充\",\n      \"head_type\": \"MaintenanceAction\",\n      \"relation\": \"prevented_by\",\n      \"tail_surface\": \"do not operate the pump set without liquid fill\",\n      \"tail_canonical_zh\": \"不要在没有液体填充的情况下操作泵组\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"Do not operate the pump set without liquid fill. Prime the pump according to operating instructions.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"maintenance\",\n      \"fault_class_ids\": [\"MAINTENANCE_ACTION\"],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Stop the pump (set) immediately.\",\n      \"head_canonical_zh\": \"立即停泵（组）\",\n      \"head_type\": \"InspectionAction\",\n      \"relation\": \"prevented_by\",\n      \"tail_surface\": \"abnormal noises, vibrations, temperatures or leakage\",\n      \"tail_canonical_zh\": \"异常噪音、振动、温度或泄漏\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"Abnormal noises, vibrations, temperatures or leakage could cause damage to the pump. Stop the pump (set) immediately. Eliminate the causes before returning the pump set to service.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [\"INSPECTION_ACTION\"],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    }\n  ],\n  \"warnings\": []\n}",
