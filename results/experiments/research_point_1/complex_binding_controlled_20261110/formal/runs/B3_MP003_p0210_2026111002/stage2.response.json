{
  "content": "{\n  \"triples\": [\n    {\n      \"head_surface\": \"Gear cases are to be of substantial construction in order to minimize elastic deflections and maintain accurate mounting of the gears.\",\n      \"head_canonical_zh\": \"齿轮箱应具有足够的结构以最小化弹性变形并保持齿轮的准确安装\",\n      \"head_type\": \"Component\",\n      \"relation\": \"specifies_by\",\n      \"tail_surface\": \"Calculations, in accordance with the manufacturer's code of practice, substantiating these Rule requirements are to be submitted.\",\n      \"tail_canonical_zh\": \"提交根据制造商的工艺规范进行计算，以证明这些规定的要求\",\n      \"tail_type\": \"Standard\",\n      \"evidence_text\": \"Calculations, in accordance with the manufacturer's code of practice, substantiating these Rule requirements are to be submitted.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    },\n    {\n      \"head_surface\": \"For gear case designs for which the manufacturer can provide a satisfactory service history, submission of calculations may be waived.\",\n      \"head_canonical_zh\": \"对于制造商可以提供满意的服务历史的齿轮箱设计，可以免除提交计算\",\n      \"head_type\": \"Component\",\n      \"relation\": \"specifies_by\",\n      \"tail_surface\": \"Calculations, in accordance with the manufacturer's code of practice, substantiating these Rule requirements are to be submitted.\",\n      \"tail_canonical_zh\": \"提交根据制造商的工艺规范进行计算，以证明这些规定的要求\",\n      \"tail_type\": \"Standard\",\n      \"evidence_text\": \"For gear case designs for which the manufacturer can provide a satisfactory service history, submission of calculations may be waived.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    },\n    {\n      \"head_surface\": \"The construction of gear cases is to be such that sufficient number of access is provided for adequate inspection of gears, checking of gear teeth contacts and measurement of thrust bearing clearance.\",\n      \"head_canonical_zh\": \"齿轮箱的构造应确保有足够的访问点，以便对齿轮进行充分检查，检查齿轮啮合情况，并测量推力轴承间隙\",\n      \"head_type\": \"Component\",\n      \"relation\": \"specifies_by\",\n      \"tail_surface\": \"Alternative methods such as use of special viewing devices may be considered.\",\n      \"tail_canonical_zh\": \"可考虑使用特殊观察设备等替代方法\",\n      \"tail_type\": \"InspectionMethod\",\n      \"evidence_text\": \"The construction of gear cases is to be such that sufficient number of access is provided for adequate inspection of gears, checking of gear teeth contacts and measurement of thrust bearing clearance. Alternative methods such as use of special viewing devices may be considered.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    },\n    {\n      \"head_surface\": \"Gear cases are to be of substantial construction in order to minimize elastic deflections and maintain accurate mounting of the gears.\",\n      \"head_canonical_zh\": \"齿轮箱应具有足够的结构以最小化弹性变形并保持齿轮的准确安装\",\n      \"head_type\": \"Component\",\n      \"relation\": \"specifies_by\",\n      \"tail_surface\": \"They are to be designed to withstand without deleterious deflection: the tooth forces generated by the gear elements, thrust bearing arrangement, line shaft alignment, prime mover(s), clutches, couplings and accessories, under all modes of operation.\",\n      \"tail_canonical_zh\": \"它们应设计为在所有操作模式下承受无害变形：由齿轮元件产生的齿力、推力轴承布置、线轴对准、主推进装置（多个）、离合器、联轴器和附件\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"Gear cases are to be of substantial construction in order to minimize elastic deflections and maintain accurate mounting of the gears. They are to be designed to withstand without deleterious deflection: the tooth forces generated by the gear elements, thrust bearing arrangement, line shaft alignment, prime mover(s), clutches, couplings and accessories, under all modes of operation.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"operating_condition\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    },\n    {\n      \"head_surface\": \"The construction of gear cases is to be such that sufficient number of access is provided for adequate inspection of gears, checking of gear teeth contacts and measurement of thrust bearing clearance.\",\n      \"head_canonical_zh\": \"齿轮箱的构造应确保有足够的访问点，以便对齿轮进行充分检查，检查齿轮啮合情况，并测量推力轴承间隙\",\n      \"head_type\": \"Component\",\n      \"relation\": \"specifies_by\",\n      \"tail_surface\": \"The construction of gear cases is to be such that sufficient number of access is provided for adequate inspection of gears, checking of gear teeth contacts and measurement of thrust bearing clearance.\",\n      \"tail_canonical_zh\": \"齿轮箱的构造应确保有足够的访问点，以便对齿轮进行充分检查，检查齿轮啮合情况，并测量推力轴承间隙\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"The construction of gear cases is to be such that sufficient number of access is provided for adequate inspection of gears, checking of gear teeth contacts and measurement of thrust bearing clearance.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"structural_context\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    }\n  ],\n  \"warnings\": []\n}",
