  "content": "{\n  \"triples\": [\n    {\n      \"head_surface\": \"Check the temperature before opening any covers, plates, or plugs.\",\n      \"head_canonical_zh\": \"检查温度再打开任何盖板、板或插口\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"inspected_by\",\n      \"tail_surface\": \"温度\",\n      \"tail_canonical_zh\": \"温度\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"Check the temperature before opening any covers, plates, or plugs.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"Close the suction and discharge valves.\",\n      \"head_canonical_zh\": \"关闭吸入和排出阀\",\n      \"head_type\": \"MaintenanceAction\",\n      \"relation\": \"maintained_by\",\n      \"tail_surface\": \"阀门\",\n      \"tail_canonical_zh\": \"阀门\",\n      \"tail_type\": \"Component\",\n      \"evidence_text\": \"Close the suction and discharge valves.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"maintenance\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"Vent the pump slowly and cautiously.\",\n      \"head_canonical_zh\": \"缓慢谨慎地排气\",\n      \"head_type\": \"MaintenanceAction\",\n      \"relation\": \"maintained_by\",\n      \"tail_surface\": \"泵\",\n      \"tail_canonical_zh\": \"泵\",\n      \"tail_type\": \"Equipment\",\n      \"evidence_text\": \"Vent the pump slowly and cautiously.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"maintenance\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"Drain the pump.\",\n      \"head_canonical_zh\": \"排空泵\",\n      \"head_type\": \"MaintenanceAction\",\n      \"relation\": \"maintained_by\",\n      \"tail_surface\": \"泵\",\n      \"tail_canonical_zh\": \"泵\",\n      \"tail_type\": \"Equipment\",\n      \"evidence_text\": \"Drain the pump.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"maintenance\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"Do not attempt to pump any liquids the pump has not been designed for.\",\n      \"head_canonical_zh\": \"不要尝试泵送泵未设计用于输送的任何液体\",\n      \"head_type\": \"Risk\",\n      \"relation\": \"increases_risk_of\",\n      \"tail_surface\": \"损坏泵或危及人员\",\n      \"tail_canonical_zh\": \"损坏泵或危及人员\",\n      \"tail_type\": \"Risk\",\n      \"evidence_text\": \"Do not attempt to pump any liquids the pump has not been designed for, and which may damage the pump or endanger personnel as a result of pump failure.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"risk\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"Suction and discharge hoses and piping must be removed from the pump before lifting.\",\n      \"head_canonical_zh\": \"提升前必须从泵上拆下吸入和排出软管及管道\",\n      \"head_type\": \"OperatingCondition\",\n      \"relation\": \"specifies\",\n      \"tail_surface\": \"提升操作\",\n      \"tail_canonical_zh\": \"提升操作\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"Suction and discharge hoses and piping must 