  "content": "{\n  \"triples\": [\n    {\n      \"head_surface\": \"The pump must be filled with liquid before it is started.\",\n      \"head_canonical_zh\": \"泵启动前必须充满液体\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"specifies\",\n      \"tail_surface\": \"Cornell Redi-Prime®\",\n      \"tail_canonical_zh\": \"Cornell Redi-Prime®\",\n      \"tail_type\": \"Equipment\",\n      \"evidence_text\": \"The pump must be filled with liquid before it is started.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Automatic priming is used for unattended operation.\",\n      \"head_canonical_zh\": \"自动充液用于无人操作\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"specifies\",\n      \"tail_surface\": \"Cornell Redi-Prime®\",\n      \"tail_canonical_zh\": \"Cornell Redi-Prime®\",\n      \"tail_type\": \"Equipment\",\n      \"evidence_text\": \"Automatic priming is used for unattended operation.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Electric sensing and controls prime the unit before start-up.\",\n      \"head_canonical_zh\": \"电感测和控制在启动前充液\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"specifies\",\n      \"tail_surface\": \"Cornell Redi-Prime®\",\n      \"tail_canonical_zh\": \"Cornell Redi-Prime®\",\n      \"tail_type\": \"Equipment\",\n      \"evidence_text\": \"Electric sensing and controls prime the unit before start-up.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"There is no water carry-over.\",\n      \"head_canonical_zh\": \"没有水携带过\",\n      \"head_type\": \"Symptom\",\n      \"relation\": \"manifests_as\",\n      \"tail_surface\": \"Cornell Redi-Prime®\",\n      \"tail_canonical_zh\": \"Cornell Redi-Prime®\",\n      \"tail_type\": \"Equipment\",\n      \"evidence_text\": \"Cornell Redi-Prime, fully automated, self-priming pumps are ideal for unattended operation. Our positive sealing float box and diaphragm vacuum pump configuration insures that there is no water carry-over.\",\n      \"evidence_mode\": \"E2_table_cells\",\n      \"evidence_unit_ids\": [\"MP020:p0018:t00:r000:c00\", \"MP020:p0018:t00:r001:c00\"],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Cornell Redi-Prime pumps handle air/water mixtures with ease.\",\n      \"head_canonical_zh\": \"Cornell Redi-Prime 泵轻松处理空气/水混合物\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"specifies\",\n      \"tail_surface\": \"Cornell Redi-Prime®\",\n      \"tail_canonical_zh\": \"Cornell Redi-Prime®\",\n      \"tail_type\": \"Equipment\",\n      \"evidence_text\": \"Cornell Redi-Prime pumps handle air/water mixtures with ease.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.95,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    }\n  ],\n  \"warnings\": []\n}",
