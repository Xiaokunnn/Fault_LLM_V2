  "content": "{\n  \"triples\": [\n    {\n      \"head_surface\": \"DO NOT exceed the pumps rated pressure, speed, and the pump, or change the system/duty parameters from those the pump was originally supplied, without confirming its suitability for the new service.\",\n      \"head_canonical_zh\": \"不得超过泵的额定压力、速度和温度，或更改系统/职责参数，除非确认其适合新服务。\",\n      \"head_type\": \"OperatingCondition\",\n      \"relation\": \"increases_risk_of\",\n      \"tail_surface\": \"DO NOT place fingers into the pumping chamber, or its connection ports, or into any part of the drive train if there is any possibility of the pump shaft being rotated.\",\n      \"tail_canonical_zh\": \"不得将手指伸入泵室、连接口或驱动装置的任何部分，如果有可能使泵轴旋转。\",\n      \"tail_type\": \"Risk\",\n      \"evidence_text\": \"DO NOT exceed the pumps rated pressure, speed, and the pump, or change the system/duty parameters from those the pump was originally supplied, without confirming its suitability for the new service. DO NOT place fingers into the pumping chamber, or its connection ports, or into any part of the drive train if there is any possibility of the pump shaft being rotated.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"risk\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"DO NOT place fingers into the pumping chamber, or its connection ports, or into any part of the drive train if there is any possibility of the pump shaft being rotated.\",\n      \"head_canonical_zh\": \"不得将手指伸入泵室、连接口或驱动装置的任何部分，如果有可能使泵轴旋转。\",\n      \"head_type\": \"Risk\",\n      \"relation\": \"causes\",\n      \"tail_surface\": \"DO NOT exceed the pumps rated pressure, speed, and the pump, or change the system/duty parameters from those the pump was originally supplied, without confirming its suitability for the new service.\",\n      \"tail_canonical_zh\": \"不得超过泵的额定压力、速度和温度，或更改系统/职责参数，除非确认其适合新服务。\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"DO NOT exceed the pumps rated pressure, speed, and the pump, or change the system/duty parameters from those the pump was originally supplied, without confirming its suitability for the new service. DO NOT place fingers into the pumping chamber, or its connection ports, or into any part of the drive train if there is any possibility of the pump shaft being rotated.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"risk\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"DO NOT operate pump if the suction or discharge piping is not connected.\",\n      \"head_canonical_zh\": \"如果吸水管或排水管未连接，则不得启动泵。\",\n      \"head_type\": \"OperatingCondition\",\n      \"relation\": \"increases_risk_of\",\n      \"tail_surface\": \"DO NOT place fingers into the pumping chamber, or its connection ports, or into any part of the drive train if there is any possibility of the pump shaft being rotated.\",\n      \"tail_canonical_zh\": \"不得将手指伸入泵室、连接口或驱动装置的任何部分，如果有可能使泵轴旋转。\",\n      \"tail_type\": \"Risk\",\n      \"evidence_text\": \"DO NOT operate pump if the suction or discharge piping is not connected. DO NOT place fingers into the pumping chamber, or its connection ports, or into any part of the drive train if there is any possibility of the pump shaft being rotated.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"risk\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"DO NOT operate pump if the suction or discharge piping is not connected.\",\n      \"head_canonical_zh\": \"如果吸水管或排水管未连接，则不得启动泵。\",\n      \"head_type\": \"OperatingCondition\",\n      \"relation\": \"causes\",\n      \"tail_surface\": \"DO NOT place fingers into the pumping chamber, or its connection ports, or into any part of the drive train if there is any possibility of the pump shaft being rotated.\",\n      \"tail_canonical_zh\": \"不得将手指伸入泵室、连接口或驱动装置的任何部分，如果有可能使泵轴旋转。\",\n      \"tail_type\": \"Risk\",\n      \"evidence_text\": \"DO NOT operate pump if the suction or discharge piping is not connected. DO NOT place fingers into the pumping chamber, or its connection ports, or into any part of the drive train if there is any possibility of the pump shaft being rotated.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"risk\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"DO NOT attempt to dismantle a pressure relief valve that has not had the spring pressure relieved or is mounted on a pump that is operating.\",\n      \"head_canonical_zh\": \"不得拆卸未释放弹簧压力或安装在正在运行的泵上的安全阀。\",\n      \"head_type\": \"OperatingCondition\",\n      \"relation\": \"increases_risk_of\",\n      \"tail_surface\": \"DO NOT place fingers into the pumping chamber, or its connection ports, or into any part of the drive train if there is any possibility of the pump shaft being rotated.\",\n      \"tail_canonical_zh\": \"不得将手指伸入泵室、连接口或驱动装置的任何部分，如果有可能使泵轴旋转。\",\n      \"tail_type\": \"Risk\",\n      \"evidence_text\": \"DO NOT attempt to dismantle a pressure relief valve that has not had the spring pressure relieved or is mounted on a pump that is operating. DO NOT place fingers into the pumping chamber, or its connection ports, or into any part of the drive train if there is any possibility of the pump shaft being rotated.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"risk\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    },\n    {\n      \"head_surface\": \"DO NOT attempt to dismantle a pressure relief valve that has not had the spring pressure relieved or is mounted on a pump that is operating.\",\n      \"head_canonical_zh\": \"不得拆卸未释放弹簧压力或安装在正在运行的泵上的安全阀。\",\n      \"head_type\": \"OperatingCondition\",\n      \"relation\": \"causes\",\n      \"tail_surface\": \"DO NOT place fingers into the pumping chamber, or its connection ports, or into any part of the drive train if there is any possibility of the pump shaft being rotated.\",\n      \"tail_canonical_zh\": \"不得将手指伸入泵室、连接口或驱动装置的任何部分，如果有可能使泵轴旋转。\",\n      \"tail_type\": \"Risk\",\n      \"evidence_text\": \"DO NOT attempt to dismantle a pressure relief valve that has not had the spring pressure relieved or is mounted on a pump that is operating. DO NOT place fingers into the pumping chamber, or its connection ports, or into any part of the drive train if there is any possibility of the pump shaft being rotated.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"risk\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.9,\n      \"tail_translation_confidence\": 0.9\n    }\n  ],\n  \"warnings\": []\n}",
