{
  "content": "{\n  \"triples\": [\n    {\n      \"head_surface\": \"Do not operate the pump with the shut-off elements in the suction line and/or discharge line closed.\",\n      \"head_canonical_zh\": \"不得关闭吸入管线和/或排出管线的切断元件启动泵\",\n      \"head_type\": \"OperatingCondition\",\n      \"relation\": \"causes\",\n      \"tail_surface\": \"incorrect pressure and temperature\",\n      \"tail_canonical_zh\": \"不正确的压力和温度\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"Do not operate the pump with the shut-off elements in the suction line and/or discharge line closed. Only start up the pump set with the discharge-side shut-off element slightly or fully open.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [\"1001\"],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Do not operate the pump set without liquid fill.\",\n      \"head_canonical_zh\": \"不得在无液体填充的情况下操作泵组\",\n      \"head_type\": \"OperatingCondition\",\n      \"relation\": \"increases_risk_of\",\n      \"tail_surface\": \"high temperature due to dry running or too much gas content in the fluid handled\",\n      \"tail_canonical_zh\": \"由于干运转或处理流体中气体含量过高导致的高温\",\n      \"tail_type\": \"Risk\",\n      \"evidence_text\": \"Do not operate the pump set without liquid fill. Prime the pump according to operating instructions.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"risk\",\n      \"fault_class_ids\": [\"1002\"],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Abnormal noises, vibrations, temperatures or leakage could cause damage to the pump.\",\n      \"head_canonical_zh\": \"异常噪音、振动、温度或泄漏可能导致泵损坏\",\n      \"head_type\": \"Symptom\",\n      \"relation\": \"manifests_as\",\n      \"tail_surface\": \"Stop the pump (set) immediately. Eliminate the causes before returning the pump set to service.\",\n      \"tail_canonical_zh\": \"立即停泵（组）。在将泵组重新投入使用前消除原因\",\n      \"tail_type\": \"MaintenanceAction\",\n      \"evidence_text\": \"Abnormal noises, vibrations, temperatures or leakage could cause damage to the pump. Stop the pump (set) immediately. Eliminate the causes before returning the pump set to service.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"maintenance\",\n      \"fault_class_ids\": [\"1003\"],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Do not operate the pump with the suction and/or discharge line closed will cause incorrect pressure and temperature.\",\n      \"head_canonical_zh\": \"不得关闭吸入管线和/或排出管线将导致不正确的压力和温度\",\n      \"head_type\": \"FaultMode\",\n      \"relation\": \"manifests_as\",\n      \"tail_surface\": \"incorrect pressure and temperature\",\n      \"tail_canonical_zh\": \"不正确的压力和温度\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"If the pump is operated with the suction and/or discharge line closed will cause incorrect pressure and temperature. Hot or hazard fluids under pressure will cause death or serious injury.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [\"1001\"],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"Do not operate the pump with the suction and/or discharge line closed will cause incorrect pressure and temperature.\",\n      \"head_canonical_zh\": \"不得关闭吸入管线和/或排出管线将导致不正确的压力和温度\",\n      \"head_type\": \"FaultMode\",\n      \"relation\": \"manifests_as\",\n      \"tail_surface\": \"Hot or hazard fluids under pressure will cause death or serious injury.\",\n      \"tail_canonical_zh\": \"高压下的热或危险流体会导致死亡或严重伤害\",\n      \"tail_type\": \"Symptom\",\n      \"evidence_text\": \"If the pump is operated with the suction and/or discharge line closed will cause incorrect pressure and temperature. Hot or hazard fluids under pressure will cause death or serious injury.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [\"1001\"],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    },\n    {\n      \"head_surface\": \"High temperature due to dry running or too much gas content in the fluid handled will cause death or serious injury.\",\n      \"head_canonical_zh\": \"由于干运转或处理流体中气体含量过高导致的高温将导致死亡或严重伤害\",\n      \"head_type\": \"Symptom\",\n      \"relation\": \"manifests_as\",\n      \"tail_surface\": \"Do not operate the pump set without liquid fill.\",\n      \"tail_canonical_zh\": \"不得在无液体填充的情况下操作泵组\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"High temperature due to dry running or too much gas content in the fluid handled will cause death or serious injury. Do not operate the pump set without liquid fill.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"operating_condition\",\n      \"fault_class_ids\": [\"1002\"],\n      \"model_confidence\": 0.9,\n      \"head_translation_confidence\": 0.95,\n      \"tail_translation_confidence\": 0.95\n    }\n  ],\n  \"warnings\": []\n}",
