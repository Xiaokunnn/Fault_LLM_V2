{
  "content": "{\n  \"triples\": [\n    {\n      \"head_surface\": \"Corrosion monitoring techniques\",\n      \"head_canonical_zh\": \"腐蚀监测技术\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"provides_help_to\",\n      \"tail_surface\": \"operator\",\n      \"tail_canonical_zh\": \"操作员\",\n      \"tail_type\": \"InspectionAction\",\n      \"evidence_text\": \"Corrosion monitoring techniques (i.e., coupon testing, corrometer testing) can provide the following help to the operator:\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    },\n    {\n      \"head_surface\": \"Corrosion monitoring techniques\",\n      \"head_canonical_zh\": \"腐蚀监测技术\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"indicates\",\n      \"tail_surface\": \"damaging conditions\",\n      \"tail_canonical_zh\": \"损坏条件\",\n      \"tail_type\": \"FaultMode\",\n      \"evidence_text\": \"●  By providing early warning that damaging conditions exist which may result in a corrosion-induced failure;\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [\"corrosion_induced_failure\"],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    },\n    {\n      \"head_surface\": \"Corrosion monitoring techniques\",\n      \"head_canonical_zh\": \"腐蚀监测技术\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"indicates\",\n      \"tail_surface\": \"changes in process parameters\",\n      \"tail_canonical_zh\": \"工艺参数的变化\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"●  By examining the correlation of changes in process parameters and their effect on system corrosivity;\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    },\n    {\n      \"head_surface\": \"Corrosion monitoring techniques\",\n      \"head_canonical_zh\": \"腐蚀监测技术\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"indicates\",\n      \"tail_surface\": \"root cause(s) of a particular corrosion problem\",\n      \"tail_canonical_zh\": \"特定腐蚀问题的根本原因\",\n      \"tail_type\": \"Cause\",\n      \"evidence_text\": \"●  By determining the root cause(s) of a particular corrosion problem, and identifying the rate controlling parameters, such as pressure, temperature, pH, flow rate, etc.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [\"corrosion_problem\"],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    },\n    {\n      \"head_surface\": \"Corrosion monitoring techniques\",\n      \"head_canonical_zh\": \"腐蚀监测技术\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"indicates\",\n      \"tail_surface\": \"effectiveness of corrosion control/prevention techniques\",\n      \"tail_canonical_zh\": \"腐蚀控制/预防技术的有效性\",\n      \"tail_type\": \"SignalFeature\",\n      \"evidence_text\": \"●  By evaluating the effectiveness of corrosion control/prevention techniques in systems, such as chemical inhibition and the determination of optimal applications.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    },\n    {\n      \"head_surface\": \"Corrosion monitoring techniques\",\n      \"head_canonical_zh\": \"腐蚀监测技术\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"indicates\",\n      \"tail_surface\": \"maintenance requirements and ongoing condition of the equipment/system\",\n      \"tail_canonical_zh\": \"设备/系统的维护需求和持续状态\",\n      \"tail_type\": \"Risk\",\n      \"evidence_text\": \"●  By providing the operator and shore side management information relating to the maintenance requirements and ongoing condition of the equipment/system.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"symptom\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    },\n    {\n      \"head_surface\": \"Corrosion monitoring techniques\",\n      \"head_canonical_zh\": \"腐蚀监测技术\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"does_not_waive\",\n      \"tail_surface\": \"close-up surveys required by the ABS Rules\",\n      \"tail_canonical_zh\": \"ABS规则要求的详细检查\",\n      \"tail_type\": \"InspectionAction\",\n      \"evidence_text\": \"Corrosion monitoring as described in this Section does not waive any of the close-up surveys required by the ABS Rules.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"standard\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    },\n    {\n      \"head_surface\": \"Coupon testing\",\n      \"head_canonical_zh\": \"试片测试\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"can_be_used_for\",\n      \"tail_surface\": \"process facilities, underground/undersea structures, fresh water or sea water cooling systems, and electrical generating systems, and for cathodic protection monitoring, abrasive slurry transport, and atmospheric corrosion monitoring\",\n      \"tail_canonical_zh\": \"工艺设施、地下/海底结构、淡水或海水冷却系统、发电系统，以及阴极保护监测、磨蚀性浆液运输和大气腐蚀监测\",\n      \"tail_type\": \"OperatingCondition\",\n      \"evidence_text\": \"This technique can be used to perform tests at process facilities, underground/undersea structures, fresh water or sea water cooling systems, and electrical generating systems, and for cathodic protection monitoring, abrasive slurry transport, and atmospheric corrosion monitoring.\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"operating_condition\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    },\n    {\n      \"head_surface\": \"Coupon testing\",\n      \"head_canonical_zh\": \"试片测试\",\n      \"head_type\": \"InspectionMethod\",\n      \"relation\": \"requires\",\n      \"tail_surface\": \"trained and experienced technician\",\n      \"tail_canonical_zh\": \"受过训练且有经验的技术人员\",\n      \"tail_type\": \"InspectionAction\",\n      \"evidence_text\": \"●  Skill level: Trained and experienced technician\",\n      \"evidence_mode\": \"E1_contiguous_text\",\n      \"evidence_unit_ids\": [],\n      \"evidence_role\": \"inspection\",\n      \"fault_class_ids\": [],\n      \"model_confidence\": 1.0,\n      \"head_translation_confidence\": 1.0,\n      \"tail_translation_confidence\": 1.0\n    }\n  ],\n  \"warnings\": []\n}",
