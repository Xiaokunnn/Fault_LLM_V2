        "x0": 303.641,
        "x1": 497.331
      }
    },
    {
      "id": "MP019:p0107:b0037",
      "text": "Specifikationerna ovan gäller när omgivningstempera-",
      "bbox": {
        "bottom": 310.961,
        "top": 300.961,
        "x0": 36.003,
        "x1": 274.733
      }
    },
    {
      "id": "MP019:p0107:b0038",
