        "x1": 549.751
      }
    },
    {
      "id": "MP019:p0107:b0048",
      "text": "Tillsatser rekommenderas, men en skriftlig garanti",
      "bbox": {
        "bottom": 399.961,
        "top": 389.961,
        "x0": 36.003,
        "x1": 256.773
      }
    },
    {
      "id": "MP019:p0107:b0049",
      "text": "hos ovan nämnda smörjmedel. Smörjintervallen gäller för",
