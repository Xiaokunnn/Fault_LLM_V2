        "bottom": 371.911,
        "top": 361.911,
        "x0": 303.641,
        "x1": 445.611
      }
    },
    {
      "id": "MP019:p0107:b0046",
      "text": "ovanstående egenskaper.",
      "bbox": {
        "bottom": 379.461,
        "top": 369.461,
