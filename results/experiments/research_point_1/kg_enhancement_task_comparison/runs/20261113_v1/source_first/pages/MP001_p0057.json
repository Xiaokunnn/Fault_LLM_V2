        "top": 526.991,
        "x1": 371.479,
        "bottom": 536.991
      },
      "reading_order": 76,
      "block_type": "text_line"
    },
    {
      "block_id": "MP001:p0057:b0077",
      "text": "● ISO 1925: Mechanical vibration – Balancing – Vocabulary",
