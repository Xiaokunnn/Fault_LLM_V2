        "bottom": 627.247
      },
      "reading_order": 81,
      "block_type": "text_line"
    },
    {
      "block_id": "MP001:p0057:b0082",
      "text": "● ISO 2017: Mechanical vibration and shock -- Resilient mounting systems",
      "bbox": {
        "x0": 126.004,
        "top": 634.74,
        "x1": 454.612,
        "bottom": 645.247
      },
      "reading_order": 82,
      "block_type": "text_line"
    },
    {
      "block_id": "MP001:p0057:b0083",
      "text": "Part 1: Technical information to be exchanged for the application of isolation systems",
      "bbox": {
