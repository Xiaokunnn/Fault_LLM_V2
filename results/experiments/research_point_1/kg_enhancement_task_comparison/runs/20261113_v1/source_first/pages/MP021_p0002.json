        "top": 458.345,
        "x1": 95.04,
        "bottom": 467.345
      },
      "reading_order": 65,
      "block_type": "text_line"
    },
    {
      "block_id": "MP021:p0002:b0066",
      "text": "AVOID contact with hot areas of the pump and/or drive.",
