        "x0": 310.5,
        "top": 493.145,
        "x1": 534.609,
        "bottom": 502.145
      },
      "reading_order": 71,
      "block_type": "text_line"
    },
    {
      "block_id": "MP021:p0002:b0072",
      "text": "temperatures on the pump and/or drive.",
      "bbox": {
        "x0": 310.5,
        "top": 503.645,
        "x1": 468.576,
        "bottom": 512.645
