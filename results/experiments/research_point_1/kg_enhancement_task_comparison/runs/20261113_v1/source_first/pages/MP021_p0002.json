      "reading_order": 88,
      "block_type": "text_line"
    },
    {
      "block_id": "MP021:p0002:b0089",
      "text": "suitability for the new service.",
      "bbox": {
        "x0": 36.0,
        "top": 602.045,
        "x1": 153.54,
        "bottom": 611.045
      },
      "reading_order": 89,
      "block_type": "text_line"
    },
    {
      "block_id": "MP021:p0002:b0090",
      "text": "always point towards suction side of the pump. If pump",
      "bbox": {
        "x0": 310.5,
        "top": 612.245,
        "x1": 529.101,
        "bottom": 621.245
