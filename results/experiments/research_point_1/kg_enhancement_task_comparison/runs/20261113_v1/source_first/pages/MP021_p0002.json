      "reading_order": 78,
      "block_type": "text_line"
    },
    {
      "block_id": "MP021:p0002:b0079",
      "text": "THE PUMP must be provided with pressure protection. This",
      "bbox": {
        "x0": 310.5,
        "top": 549.245,
        "x1": 548.428,
        "bottom": 558.704
