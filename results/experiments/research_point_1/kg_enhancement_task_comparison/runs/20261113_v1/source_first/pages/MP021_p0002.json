        "top": 503.945,
        "x1": 255.101,
        "bottom": 513.404
      },
      "reading_order": 73,
      "block_type": "text_line"
    },
    {
      "block_id": "MP021:p0002:b0074",
      "text": "connection ports, or into any part of the drive train if there is",
      "bbox": {
        "x0": 36.0,
        "top": 514.445,
        "x1": 273.114,
        "bottom": 523.445
      },
      "reading_order": 74,
      "block_type": "text_line"
    },
