      "block_id": "MP021:p0002:b0080",
      "text": "WARNING",
      "bbox": {
        "x0": 136.685,
        "top": 549.384,
        "x1": 207.284,
        "bottom": 563.384
      },
      "reading_order": 80,
      "block_type": "text_line"
    },
    {
      "block_id": "MP021:p0002:b0081",
      "text": "may be provided through a relief valve mounted directly on",
      "bbox": {
        "x0": 310.5,
        "top": 559.745,
        "x1": 544.104,
        "bottom": 568.745
