      "bbox": {
        "x0": 310.5,
        "top": 570.245,
        "x1": 541.089,
        "bottom": 579.245
      },
      "reading_order": 82,
      "block_type": "text_line"
    },
    {
      "block_id": "MP021:p0002:b0083",
      "text": "DO NOT exceed the pumps rated pressure, speed, and",
      "bbox": {
        "x0": 36.0,
        "top": 570.545,
        "x1": 257.1,
        "bottom": 580.004
      },
      "reading_order": 83,
      "block_type": "text_line"
    },
    {
      "block_id": "MP021:p0002:b0084",
      "text": "device, or a rupture disk. If pump rotation may be reversed",
