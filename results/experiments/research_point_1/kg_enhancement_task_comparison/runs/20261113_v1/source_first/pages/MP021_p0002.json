        "x0": 310.5,
        "top": 580.745,
        "x1": 543.6,
        "bottom": 589.745
      },
      "reading_order": 84,
      "block_type": "text_line"
    },
    {
      "block_id": "MP021:p0002:b0085",
      "text": "temperature, or change the system/duty parameters from",
      "bbox": {
        "x0": 36.0,
        "top": 581.045,
        "x1": 263.592,
        "bottom": 590.045
