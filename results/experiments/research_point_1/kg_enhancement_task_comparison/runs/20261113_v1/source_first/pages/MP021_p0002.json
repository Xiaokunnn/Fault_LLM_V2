        "x0": 40.5,
        "top": 662.645,
        "x1": 173.052,
        "bottom": 671.645
      },
      "reading_order": 98,
      "block_type": "text_line"
    },
    {
      "block_id": "MP021:p0002:b0099",
      "text": "Pump®",
      "bbox": {
        "x0": 520.431,
        "top": 664.282,
        "x1": 547.813,
        "bottom": 673.745
