        "bottom": 294.948
      },
      "reading_order": 46,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0047",
      "text": "• Gebruik bochten met een grote straal en kleppen met",
      "bbox": {
        "x0": 207.0,
        "top": 292.387,
        "x1": 346.912,
        "bottom": 299.387
      },
      "reading_order": 47,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0048",
      "text": "volledige boring.",
      "bbox": {
        "x0": 216.0,
        "top": 300.787,
        "x1": 257.937,
        "bottom": 307.787
      },
      "reading_order": 48,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0049",
      "text": "OPGELET",
      "bbox": {
        "x0": 49.68,
        "top": 302.523,
        "x1": 81.747,
        "bottom": 309.523
      },
      "reading_order": 49,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0050",
      "text": "De apparatuur is onvolledig en mag niet in bedrijf",
      "bbox": {
        "x0": 49.68,
        "top": 310.923,
        "x1": 181.545,
        "bottom": 317.923
      },
      "reading_order": 50,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0051",
      "text": "• Vermijd bol- of naaldkleppen op viskeuze vloeistoffen.",
      "bbox": {
        "x0": 207.0,
        "top": 311.347,
        "x1": 349.48,
        "bottom": 318.347
      },
      "reading_order": 51,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0052",
      "text": "worden gesteld voordat de machine waarin zij zal",
      "bbox": {
        "x0": 49.68,
        "top": 319.323,
        "x1": 179.578,
        "bottom": 326.323
      },
      "reading_order": 52,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0053",
      "text": "• Plaats isolatiekleppen aan elke kant van de pomp om het",
      "bbox": {
        "x0": 207.0,
        "top": 321.907,
        "x1": 355.256,
        "bottom": 328.907
      },
      "reading_order": 53,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0054",
      "text": "worden ingebouwd, in overeenstemming met de",
      "bbox": {
        "x0": 49.68,
        "top": 327.723,
        "x1": 178.703,
        "bottom": 334.723
      },
      "reading_order": 54,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0055",
      "text": "onderhoud te vereenvoudigen.",
      "bbox": {
        "x0": 216.0,
        "top": 330.307,
        "x1": 292.215,
        "bottom": 337.307
      },
      "reading_order": 55,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0056",
      "text": "bepalingen van de richtlijn is verklaard.",
      "bbox": {
        "x0": 49.68,
        "top": 336.123,
        "x1": 154.468,
        "bottom": 343.123
      },
      "reading_order": 56,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0057",
      "text": "• Monteer vacuüm-/drukmeters aan elke kant van de pomp om",
      "bbox": {
        "x0": 207.0,
        "top": 340.867,
        "x1": 365.665,
        "bottom": 347.867
      },
      "reading_order": 57,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0058",
      "text": "de druk te controleren.",
      "bbox": {
        "x0": 216.0,
        "top": 349.267,
        "x1": 271.663,
        "bottom": 356.267
      },
      "reading_order": 58,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0059",
      "text": "OPGELET",
      "bbox": {
        "x0": 49.68,
        "top": 350.864,
        "x1": 81.747,
        "bottom": 357.864
      },
      "reading_order": 59,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0060",
      "text": "Alle bewegende delen moeten worden afgescher-",
      "bbox": {
        "x0": 49.68,
        "top": 359.264,
        "x1": 179.948,
        "bottom": 366.264
      },
      "reading_order": 60,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0061",
      "text": "• Zodra het proces is vastgesteld (en niet zal veranderen),",
      "bbox": {
        "x0": 207.0,
        "top": 359.827,
        "x1": 352.343,
        "bottom": 366.827
      },
      "reading_order": 61,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0062",
      "text": "md en in overeenstemming zijn met de geldende",
      "bbox": {
        "x0": 49.68,
        "top": 367.664,
        "x1": 179.991,
        "bottom": 374.664
      },
      "reading_order": 62,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0063",
      "text": "kunnen deze worden verwijderd.",
      "bbox": {
        "x0": 216.0,
        "top": 368.227,
        "x1": 296.267,
        "bottom": 375.227
      },
      "reading_order": 63,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0064",
      "text": "richtlijn.",
      "bbox": {
        "x0": 49.68,
        "top": 376.064,
        "x1": 72.01,
        "bottom": 383.064
      },
      "reading_order": 64,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0065",
      "text": "• Vermijd indien mogelijk filters aan de inlaatzijde van de",
      "bbox": {
        "x0": 207.0,
        "top": 378.787,
        "x1": 352.507,
        "bottom": 385.787
      },
      "reading_order": 65,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0066",
      "text": "pomp.",
      "bbox": {
        "x0": 216.0,
        "top": 387.187,
        "x1": 232.03,
        "bottom": 394.187
      },
      "reading_order": 66,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0067",
      "text": "Plaatselijke veiligheidsvoorschriften en praktijkcodes geven de",
      "bbox": {
        "x0": 27.0,
        "top": 396.292,
        "x1": 179.912,
        "bottom": 403.292
      },
      "reading_order": 67,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0068",
      "text": "• Een verstopt filter veroorzaakt cavitatie.",
      "bbox": {
        "x0": 207.0,
        "top": 397.747,
        "x1": 312.515,
        "bottom": 404.747
      },
      "reading_order": 68,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0069",
      "text": "minimaal aanvaardbare norm aan, maar als richtlijn geldt dat:",
      "bbox": {
        "x0": 27.0,
        "top": 404.692,
        "x1": 178.226,
        "bottom": 411.692
      },
      "reading_order": 69,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0070",
      "text": "• Ondersteun leidingwerk - zorg dat het gewicht van de leiding",
      "bbox": {
        "x0": 207.0,
        "top": 408.307,
        "x1": 365.315,
        "bottom": 415.307
      },
      "reading_order": 70,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0071",
      "text": "(en de vloeistof erin) niet op de pomppoorten rust.",
      "bbox": {
        "x0": 216.0,
        "top": 416.707,
        "x1": 339.724,
        "bottom": 423.707
      },
      "reading_order": 71,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0072",
      "text": "• koppelingen, riemen en riemschijven ingesloten moeten",
      "bbox": {
        "x0": 27.0,
        "top": 417.592,
        "x1": 175.32,
        "bottom": 424.592
      },
      "reading_order": 72,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0073",
      "text": "zijn om te voorkomen dat vingers, kleding of gereedschap in",
      "bbox": {
        "x0": 36.0,
        "top": 425.992,
        "x1": 183.774,
        "bottom": 432.992
      },
      "reading_order": 73,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0074",
      "text": "• Breng indien nodig compensatoren aan om te voorkomen",
      "bbox": {
        "x0": 207.0,
        "top": 427.267,
        "x1": 357.74,
        "bottom": 434.267
      },
      "reading_order": 74,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0075",
      "text": "contact komen met bewegende delen.",
      "bbox": {
        "x0": 36.0,
        "top": 434.392,
        "x1": 129.8,
        "bottom": 441.392
      },
      "reading_order": 75,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0076",
      "text": "dat thermische uitzettingskrachten op de pomp worden",
      "bbox": {
        "x0": 216.0,
        "top": 435.667,
        "x1": 351.538,
        "bottom": 442.667
      },
      "reading_order": 76,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0077",
      "text": "overgebracht.",
      "bbox": {
        "x0": 216.0,
        "top": 444.067,
        "x1": 249.62,
        "bottom": 451.067
      },
      "reading_order": 77,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0078",
      "text": "• afschermingen gemaakt moeten zijn van corrosiebestendige",
      "bbox": {
        "x0": 27.0,
        "top": 444.952,
        "x1": 183.894,
        "bottom": 451.952
      },
      "reading_order": 78,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0079",
      "text": "materialen.",
      "bbox": {
        "x0": 36.0,
        "top": 453.352,
        "x1": 64.126,
        "bottom": 460.352
      },
      "reading_order": 79,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0080",
      "text": "• Zorg ervoor dat alle pijpverbindingen:",
      "bbox": {
        "x0": 207.0,
        "top": 454.627,
        "x1": 309.016,
        "bottom": 461.627
      },
      "reading_order": 80,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0081",
      "text": "• afschermingen in gevaarlijke gebieden gemaakt moeten zijn",
      "bbox": {
        "x0": 27.0,
        "top": 463.912,
        "x1": 184.686,
        "bottom": 470.912
      },
      "reading_order": 81,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0082",
      "text": "• luchtdicht zijn onder vacuüm;",
      "bbox": {
        "x0": 216.0,
        "top": 465.187,
        "x1": 297.674,
        "bottom": 472.187
      },
      "reading_order": 82,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0083",
      "text": "van vonkvrij materiaal.",
      "bbox": {
        "x0": 36.0,
        "top": 472.312,
        "x1": 91.461,
        "bottom": 479.312
      },
      "reading_order": 83,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0084",
      "text": "• vloeistofdicht zijn onder druk, en;",
      "bbox": {
        "x0": 216.0,
        "top": 475.747,
        "x1": 306.835,
        "bottom": 482.747
      },
      "reading_order": 84,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0085",
      "text": "• afschermingen stevig moeten zijn bevestigd.",
      "bbox": {
        "x0": 27.0,
        "top": 482.872,
        "x1": 145.662,
        "bottom": 489.872
      },
      "reading_order": 85,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0086",
      "text": "• neem speciale voorzorgsmaatregelen bij het verpompen van",
      "bbox": {
        "x0": 207.0,
        "top": 486.307,
        "x1": 364.098,
        "bottom": 493.307
      },
      "reading_order": 86,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0087",
      "text": "• de pomp niet mag worden gebruikt met verwijderde",
      "bbox": {
        "x0": 27.0,
        "top": 493.432,
        "x1": 164.419,
        "bottom": 500.432
      },
      "reading_order": 87,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0088",
      "text": "gevaarlijke, hete of giftige vloeistoffen.",
      "bbox": {
        "x0": 216.0,
        "top": 494.707,
        "x1": 310.911,
        "bottom": 501.707
      },
      "reading_order": 88,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0089",
      "text": "afschermingen.",
      "bbox": {
        "x0": 36.0,
        "top": 501.832,
        "x1": 74.22,
        "bottom": 508.832
      },
      "reading_order": 89,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0090",
      "text": "2.08 Afdichtingen en spoeling",
      "bbox": {
        "x0": 207.0,
        "top": 513.179,
        "x1": 310.096,
        "bottom": 520.179
      },
      "reading_order": 90,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0091",
      "text": "2.06 Elektrisch",
      "bbox": {
        "x0": 27.0,
        "top": 522.06,
        "x1": 77.68,
        "bottom": 529.06
      },
      "reading_order": 91,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0092",
      "text": "Er zijn 2 basistypen asafdichtingen beschikbaar op de Bronzen",
      "bbox": {
        "x0": 207.0,
        "top": 524.059,
        "x1": 358.883,
        "bottom": 531.059
      },
      "reading_order": 92,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0093",
      "text": "flexibele waaierpomp. Dit zijn standaard lipafdichtingen en",
      "bbox": {
        "x0": 207.0,
        "top": 532.059,
        "x1": 351.401,
        "bottom": 539.059
      },
      "reading_order": 93,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0094",
      "text": "mechanische afdichtingen.",
      "bbox": {
        "x0": 207.0,
        "top": 540.059,
        "x1": 273.01,
        "bottom": 547.059
      },
      "reading_order": 94,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0095",
      "text": "OPGELET",
      "bbox": {
        "x0": 71.28,
        "top": 542.621,
        "x1": 103.347,
        "bottom": 549.621
      },
      "reading_order": 95,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0096",
      "text": "Het juiste type had moeten worden geselecteerd toen de pomp",
      "bbox": {
        "x0": 207.0,
        "top": 549.499,
        "x1": 361.453,
        "bottom": 556.499
      },
      "reading_order": 96,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0097",
      "text": "Elektriciteit kan letsel of de dood veroorzaken - volg",
      "bbox": {
        "x0": 49.68,
        "top": 557.128,
        "x1": 185.527,
        "bottom": 564.128
      },
      "reading_order": 97,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0098",
      "text": "oorspronkelijk werd geselecteerd, maar u moet vaststellen dat de",
      "bbox": {
        "x0": 207.0,
        "top": 557.499,
        "x1": 365.793,
        "bottom": 564.499
      },
      "reading_order": 98,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0099",
      "text": "aangebrachte afdichting geschikt is voor de toepassing voordat u",
      "bbox": {
        "x0": 207.0,
        "top": 565.499,
        "x1": 365.218,
        "bottom": 572.499
      },
      "reading_order": 99,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0100",
      "text": "goede praktijken en de plaatselijke voorschriften.",
      "bbox": {
        "x0": 49.68,
        "top": 565.528,
        "x1": 180.067,
        "bottom": 572.528
      },
      "reading_order": 100,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0101",
      "text": "de pomp start.",
      "bbox": {
        "x0": 207.0,
        "top": 573.499,
        "x1": 242.553,
        "bottom": 580.499
      },
      "reading_order": 101,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0102",
      "text": "In het bijzonder:",
      "bbox": {
        "x0": 49.68,
        "top": 573.928,
        "x1": 93.507,
        "bottom": 580.928
      },
      "reading_order": 102,
      "block_type": "text_line"
    },
    {
      "block_id": "MP016:p0034:b0103",
      "text": "34",
      "bbox": {
        "x0": 194.34,
        "top": 587.476,
        "x1": 201.66,
        "bottom": 593.476
      },
      "reading_order": 103,
      "block_type": "text_line"
    }
  ],
  "tables": [],
  "warnings": []
}
