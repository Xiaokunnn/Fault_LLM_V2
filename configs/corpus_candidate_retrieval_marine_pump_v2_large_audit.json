{
  "version": "marine_pump_corpus_candidate_retrieval_v2_large_audit",
  "eligible_split": "build_train",
  "max_pages_per_fault_role": 50,
  "max_pages_per_source_family_per_fault_role": 24,
  "max_pages_per_document": 140,
  "max_total_candidate_pages": 500,
  "adjacent_page_context_window": 3,
  "adjacent_page_score_decay": 1.0,
  "minimum_page_score": 4.5,
  "require_pump_scope_for_generic_sources": true,
  "generic_source_families": ["ABS"],
  "pump_scope_patterns": [
    "\\bpumps?\\b",
    "\\bimpeller\\w*\\b",
    "\\bsuction\\b",
    "\\bdischarge\\b",
    "\\bpump shaft\\b",
    "\\bpump casing\\b",
    "(?:泵|叶轮|吸入|排出|泵轴|泵壳)"
  ],
  "role_patterns": {
    "symptom": [
      "\\b(?:symptom|trouble|fault|failure|noise|rattle|vibrat\\w*|leak\\w*|overheat\\w*|hot|temperature|alarm|trip\\w*|unstable|fluctuat\\w*|no (?:flow|delivery|pressure)|low (?:flow|capacity|pressure|head)|reduced (?:flow|capacity|head)|cannot start|fails? to start|does not start|excessive (?:power|current))\\b",
      "(?:症状|故障|异常|噪声|异响|振动|泄漏|过热|温升|报警|跳闸|波动|无流量|流量低|压力低|扬程低|无法启动|不能启动|功率过大|电流过大)"
    ],
    "cause_or_mechanism": [
      "\\b(?:cause|caused by|due to|because|reason|result(?:s|ed)? from|insufficient|excessive|blocked|clogged|choked|obstruct\\w*|misalign\\w*|wear|worn|corrosion|erosion|dry[- ]?runn?ing|air leak|loss of prime)\\b",
      "(?:原因|导致|由于|不足|过量|堵塞|阻塞|不对中|磨损|损坏|腐蚀|冲蚀|干运转|进气|失去自吸)"
    ],
    "inspection": [
      "\\b(?:inspect\\w*|check\\w*|monitor\\w*|measure\\w*|test\\w*|verify|examin\\w*|detect\\w*|diagnos\\w*|observe|read(?:ing)?|gauge|clearance|alignment|continuity|resistance)\\b",
      "(?:检查|检验|监测|测量|测试|确认|诊断|检测|观察|读数|仪表|间隙|对中|连续性|电阻)"
    ],
    "maintenance": [
      "\\b(?:remedy|corrective|correct\\w*|action|maintain\\w*|maintenance|replace\\w*|renew\\w*|repair\\w*|clean\\w*|flush\\w*|lubricat\\w*|grease\\w*|adjust\\w*|align\\w*|tighten\\w*|dismantl\\w*|reassembl\\w*|remove\\w*|install\\w*)\\b",
      "(?:措施|处理|纠正|维护|维修|更换|更新|修理|清理|清洗|冲洗|润滑|加脂|调整|对中|紧固|拆卸|重新装配|移除|安装)"
    ]
  },
  "fault_query_terms": {
    "cavitation": ["cavitation", "cavitating", "vapor bubbles", "vapour bubbles", "NPSH"],
    "air_ingress_or_loss_of_prime": ["loss of prime", "fails to prime", "priming", "air ingress", "air leak", "suction line leak", "pump takes air"],
    "hydraulic_blockage": ["blocked", "blockage", "clogged", "choked", "obstruction", "dirty filter", "strainer", "restricted flow"],
    "impeller_or_wear_part_damage": ["impeller wear", "impeller worn", "impeller damage", "impeller erosion", "impeller corrosion", "wear ring", "wear plate"],
    "mechanical_seal_failure": ["mechanical seal", "seal leak", "seal failure", "seal damage", "seal wear", "seal overheat", "shaft seal"],
    "bearing_or_lubrication_failure": ["bearing failure", "bearing wear", "bearing noise", "bearing vibration", "bearing temperature", "lubrication", "grease"],
    "pump_motor_misalignment": ["misalignment", "misaligned", "incorrect alignment", "pump motor alignment", "coupling alignment", "shaft alignment"],
    "motor_electrical_drive_failure": ["motor failure", "motor overload", "phase loss", "phase failure", "overcurrent", "motor cannot start", "motor overheating", "motor trip"],
    "pipe_or_valve_integrity_failure": ["pipe leak", "piping leak", "line leak", "valve stuck", "valve failure", "pipe damage", "pipe rupture", "valve leakage"],
    "dry_running_or_maintenance_induced_failure": ["dry running", "run dry", "operating dry", "incorrect maintenance", "improper installation", "maintenance error", "incorrect assembly", "wrong operation"]
  },
  "page_filters": {
    "exclude_table_of_contents": true,
    "exclude_low_value_pages": true,
    "minimum_text_characters": 80,
    "near_duplicate_hamming_distance": 2
  }
}
