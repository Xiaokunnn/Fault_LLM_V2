{
  "protocol_id": "marine_pump_rp2_graphrag_v2",
  "version": "0.2.0-development",
  "status": "development_tuning_required_not_external_frozen",
  "label_policy": "Silver only; never Gold",
  "human_expert_reviewed": false,
  "runtime": {
    "require_cuda": true
  },
  "graph_root": "data/kg/marine_pump/triples/KG_v1_validated",
  "benchmark_dir": "data/kg/marine_pump/silver_evidencebench/rp2_full_graph_development_v2",
  "output_dir": "results/experiments/research_point_2/graphrag_v2_development_v2",
  "sensitivity_output_dir": "results/experiments/research_point_2/graphrag_v2_sensitivity_v2",
  "embedding": {
    "model_path": "data/model/BAAI-bge-m3",
    "backend": "sentence_transformers",
    "device": "cuda",
    "normalize_embeddings": true,
    "batch_size": 16,
    "max_length": 8192,
    "index_dir": "data/kg/marine_pump/vector_indexes/bge_m3_KG_v1_validated"
  },
  "generator": {
    "model_path": "data/model/Qwen2.5-7B-Instruct",
