    "dense_topk",
    "dense_fixed_hop",
    "dense_adaptive",
    "dense_metapath",
    "dense_ours"
  ],
  "ablation_methods": [
    "dense_ours_no_graph",
    "dense_ours_no_source_family"
  ],
  "anti_leakage": {
    "online_forbidden_fields": ["fault_class_ids", "relevant_evidence_ids"],
